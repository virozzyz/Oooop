		local e = (t < 0.05) and (t / 0.05) or exp(-(t - 0.05) * 3.2)
		return 0.9 * (n - a(n, 0.08)) * e * (0.7 + 0.3 * sin(TAU * 30 * t))
	end end },
	police_siren = { dur = 4, loop = true, fn = function() return function(t)
			local sweep = 0.5 + 0.5 * math.sin(TAU * 0.25 * t)
			local f = 520 + sweep * 430
			return 0.22 * math.sin(TAU * f * t) * (0.72 + 0.28 * math.sin(TAU * 2 * t))
		end end },
	voice_again = { dur = 1.6, fn = function() local ph = 0 return function(t)
		ph = ph + TAU * (120 + 30 * sin(TAU * 1.2 * t)) / SR
		local syl = max(0, sin(TAU * 1.9 * t)) ^ 1.5
		local vowel = sin(TAU * (500 + 300 * sin(TAU * 2 * t)) * t)
		return 0.5 * (saw(ph) * 0.5 + vowel * 0.4) * syl * exp(-t * 0.3)
	end end },
	click = { dur = 0.08, fn = function() return function(t)
		return 0.8 * nz() * exp(-t * 90) + 0.3 * sin(TAU * 1800 * t) * exp(-t * 150)
	end end },
}

local Synth = {}
function Synth:Render(def)
	local n = floor(def.dur * SR)
	local f = def.fn()
	local parts, buf, nb = {}, {}, 0
	for i = 0, n - 1 do
		local x = f(i / SR)
		if x ~= x then x = 0 end
		if not def.loop then
			local e = min(i, n - 1 - i) / (SR * 0.006)
			if e < 1 then x = x * e end
		end
		if x > 1 then x = 1 elseif x < -1 then x = -1 end
		local v = floor(x * 30000)
		if v < 0 then v = v + 65536 end
		nb = nb + 1
		buf[nb] = string.char(v % 256, floor(v / 256))
		if nb >= 8192 then
			parts[#parts + 1] = table.concat(buf)
			buf, nb = {}, 0
			task.wait()
		end
	end
	if nb > 0 then parts[#parts + 1] = table.concat(buf) end
	local data = table.concat(parts)
	local function le(v, b)
		local s = {}
		for k = 1, b do s[k] = string.char(v % 256) v = floor(v / 256) end
		return table.concat(s)
	end
	local header = "RIFF" .. le(36 + #data, 4) .. "WAVEfmt " .. le(16, 4) .. le(1, 2) .. le(1, 2) .. le(SR, 4) .. le(SR * 2, 4)
		.. le(2, 2) .. le(16, 2) .. "data" .. le(#data, 4)
	return header .. data
end

function Synth:Get(key)
	local def = SYNTH[key]
	if not def then return nil end
	local path = AUDIO_FOLDER .. "/synth4_" .. key .. ".wav"
	local okf, exists = pcall(isfile, path)
	if not (okf and exists) then
		if type(writefile) ~= "function" then return nil end
		pcall(function()
			if type(isfolder) == "function" and type(makefolder) == "function" and not isfolder(AUDIO_FOLDER) then makefolder(AUDIO_FOLDER) end
		end)
		local okw = pcall(writefile, path, Synth:Render(def))
		if not okw then return nil end
	end
	local okc, asset = pcall(getcustomasset, path)
	if okc and asset then return asset end
	return nil
end

function Audio:Resolve(key)
	local user = AUDIO_IDS[key]
	local list = {}
	if type(user) == "table" then for _, v in ipairs(user) do list[#list + 1] = v end else list[1] = user end
	for _, v in ipairs(list) do
		local id = normalizeId(v)
		if id and probe(id) then return id end
	end
	local canFile = type(isfile) == "function" and type(getcustomasset) == "function"
	if canFile then
		for _, ext in ipairs({ ".mp3", ".ogg", ".wav" }) do
			local path = AUDIO_FOLDER .. "/" .. key .. ext
			local okf, exists = pcall(isfile, path)
			if okf and exists then
				local okc, asset = pcall(getcustomasset, path)
				if okc and asset then return asset end
			end
		end
		local asset = Synth:Get(key)
		if asset then return asset end
	end
	for _, v in ipairs(AUDIO_FALLBACK[key] or {}) do
		if probe(v) then
			self.pitchFix[key] = AUDIO_PITCH[key]
			return v
		end
	end
	return nil
end

function Audio:Init()
	self.group = N("SoundGroup", { Name = randName(), Volume = Opts.Master }, SoundService)
	self.folder = N("Folder", { Name = randName() }, Workspace)
	RootMaid:Give(self.group)
	RootMaid:Give(self.folder)
	local order = { "heartbeat", "footstep_near", "footstep_far", "click", "ambient_calm", "wind", "door_creak", "door_slam", "locker",
		"pickup", "paper", "breath", "whisper", "growl", "scream", "jumpscare", "monster_breath", "ambient_tense", "chase",
		"metal_clang", "object_fall", "static", "flicker", "objective", "fail", "fuse", "power_up", "police_siren", "pshh", "voice_again" }
	task.spawn(function()
		for _, key in ipairs(order) do
			if not S.alive then return end
			local ok, id = pcall(function() return self:Resolve(key) end)
			self.ids[key] = (ok and id) or false
		end
		self.ready = true
	end)
end

function Audio:SetMaster(v)
	Opts.Master = clamp(v, 0, 1)
	if self.group then self.group.Volume = Opts.Master end
end

function Audio:Play(key, o)
	o = o or {}
	local now = os.clock()
	if self.lastPlay[key] and now - self.lastPlay[key] < (o.cooldown or 0.12) then return nil end
	self.lastPlay[key] = now
	local id = self.ids[key]
	if not id then
		if o.caption ~= false and Opts.Captions then
			local cap = o.caption or AUDIO_CAPTIONS[key]
			if cap then UI:Caption(cap) end
		end
		return nil
	end
	if self.active >= MAX_ONESHOTS and not o.priority then return nil end
	local holder
	if o.pos then
		holder = N("Part", { Anchored = true, CanCollide = false, CanQuery = false, CanTouch = false, Transparency = 1,
			Size = V(0.2, 0.2, 0.2), Position = o.pos }, self.folder)
	end
	local s = N("Sound", { SoundId = id, Volume = (o.volume or 0.5) * self.duck,
		PlaybackSpeed = (o.pitch or 1) * (self.pitchFix[key] or 1) * rand(0.94, 1.06),
		RollOffMode = Enum.RollOffMode.InverseTapered, RollOffMinDistance = o.min or 10, RollOffMaxDistance = o.max or 90,
		SoundGroup = self.group })
	s.Parent = holder or self.folder
	self.active = self.active + 1
	local done = false
	local function cleanup()
		if done then return end
		done = true
		self.active = self.active - 1
		pcall(function() s:Destroy() if holder then holder:Destroy() end end)
	end
	s.Ended:Connect(cleanup)
	s:Play()
	task.delay((s.TimeLength > 0 and s.TimeLength or 5) / math.max(s.PlaybackSpeed, 0.2) + 1.5, cleanup)
	return s
end

function Audio:Voice(text)
	local ok = pcall(function()
		local tts = N("AudioTextToSpeech", { Text = text, Volume = 1 }, self.folder)
		local out = N("AudioDeviceOutput", {}, self.folder)
		N("Wire", { SourceInstance = tts, TargetInstance = out }, self.folder)
		tts:Play()
		task.delay(7, function()
			pcall(function() tts:Destroy() out:Destroy() end)
		end)
	end)
	if not ok then self:Play("voice_again", { volume = 0.7, caption = false }) end
end

function Audio:SetLoop(key, vol)
	local id = self.ids[key]
	if not id then return end
	local l = self.loops[key]
	if not l then
		if vol <= 0.01 then return end
		local s = N("Sound", { SoundId = id, Looped = true, Volume = 0, SoundGroup = self.group })
		s.Parent = self.folder
		s:Play()
		l = { s = s, target = 0 }
		self.loops[key] = l
	end
	l.target = vol
end

function Audio:Duck(target) self.duckTarget = clamp(target, 0, 1) end

function Audio:Update(dt)
	self.duck = lerp(self.duck, self.duckTarget, clamp(dt * 2.5, 0, 1))
	local hunting = Monster.state == "Hunting" or Monster.state == "Attacking"
	local f = S.fear
	local calm = (S.hidden and 0.08 or (0.22 + S.phase * 0.025)) * (1 - clamp(f * 1.6, 0, 1))
	self:SetLoop("ambient_calm", hunting and 0 or calm)
	self:SetLoop("ambient_tense", clamp(f * 0.85, 0, 0.5) * (hunting and 0.4 or 1))
	self:SetLoop("chase", hunting and 0.5 or 0)
	self:SetLoop("wind", 0.14)
	self:SetLoop("police_siren", self.policeSiren or 0)
	for _, l in pairs(self.loops) do
		l.s.Volume = lerp(l.s.Volume, l.target * self.duck, clamp(dt * 2, 0, 1))
	end
end

function Audio:StopAll()
	for k, l in pairs(self.loops) do pcall(function() l.s:Destroy() end) self.loops[k] = nil end
	if self.folder then for _, c in ipairs(self.folder:GetChildren()) do pcall(function() c:Destroy() end) end end
	self.active = 0
	self.duck, self.duckTarget = 1, 1
end

local function pickGuiParent(gui)
	if type(gethui) == "function" then
		local ok, h = pcall(gethui)
		if ok and typeof(h) == "Instance" then
			local ok2 = pcall(function() gui.Parent = h end)
			if ok2 and gui.Parent == h then return end
		end
	end
	local cg = game:GetService("CoreGui")
	local ok3 = pcall(function() gui.Parent = cg end)
	if ok3 and gui.Parent == cg then return end
	gui.Parent = LP:WaitForChild("PlayerGui")
end

