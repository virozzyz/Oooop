function Director:Choose()
	local pp = Player:Pos()
	if not pp then return nil end
	local c = { phase = S.phase, fear = S.fear, hidden = S.hidden, pp = pp }
	local now, total, list = os.clock(), 0, {}
	for _, e in ipairs(self.events) do
		local w = e.w(c)
		if w > 0 and (not self.lastAt[e.id] or now - self.lastAt[e.id] > e.cd) then
			if e.loud then w = w * clamp(1.5 - S.fear, 0.3, 1.5) end
			if e.id == self.lastId then w = w * 0.1 end
			list[#list + 1] = { e = e, w = w }
			total = total + w
		end
	end
	if total <= 0 then return nil end
	local r = rand(0, total)
	for _, it in ipairs(list) do
		r = r - it.w
		if r <= 0 then return it.e end
	end
	return list[#list].e
end

function Director:Fire(e)
	if type(e) == "string" then
		for _, x in ipairs(self.events) do if x.id == e then e = x break end end
	end
	if type(e) ~= "table" then return end
	local pp = Player:Pos()
	if not pp then return end
	self.lastAt[e.id], self.lastId = os.clock(), e.id
	safe("evento:" .. e.id, e.run, pp)
end

function Director:Update(dt)
	if S.phase < 1 or S.cinematic or S.reading or S.ending then return end
	local ms = Monster.state
	if ms == "Hunting" or ms == "Attacking" or ms == "Special" then self.timer = math.max(self.timer, 10) return end
	self.timer = self.timer - dt
	if self.timer > 0 then return end
	self.timer = math.max(8, rand(14, 28) * (1 - S.phase * 0.08))
	self:Fire(self:Choose())
end

function Story:SetPhase(n)
	S.phase = n
	Audio:Play("objective", { volume = 0.6, caption = false })
	local function wake()
		if Monster.baseState == "Dormant" then
			Monster.baseState = "Stalking"
			if not Monster:BeginWatch(7) then Monster:SetState("Stalking") end
		end
	end
	if n == 1 then
		later(30, wake)
	elseif n >= 2 then
		wake()
	end
end

function Story:UpdateObjective()
	if not S.power then return end
	if not S.hasCard then
		UI:SetObjective("Get the access card from the Morgue (ground floor)")
	elseif not S.hasCode then
		if S.hasKey then
			UI:SetObjective("Search the Director's Office (2nd floor) for the exit override codes")
		else
			UI:SetObjective("Find the brass key hidden in the Chapel (ground floor). It opens the Director's Office.")
		end
	elseif not S.hasCutters then
		UI:SetObjective("Find bolt cutters in the basement (Maintenance) to cut the exit chains")
	else
		UI:SetObjective("Reach the exit at the far end of the ground floor. Hold to open.")
	end
end

function Story:NoteBody(id)
	local n = NOTES[id]
	if id == "p3" then
		return n.title, "CURRENT ADMISSION — WARD 07\nPatient: " .. string.upper(LP.DisplayName) ..
			"\nAdmitted 31 days ago.\n\n\"He always thinks it is the first time.\"\n\nDr. Vesper does not chase you to hurt you. He chases your scream, to silence it. Perhaps, this time, he will hear you back."
	end
	return n.title, n.body
end

local GATED = { fuse = true, card = true, key = true, code = true, cutters = true }

function Story:CanTake(k)
	if k == "fuse" then return S.phase >= 1 end
	if k == "card" then return S.power end
	if k == "key" then return S.hasCard end
	if k == "code" then return S.hasKey end
	if k == "cutters" then return S.hasCode end
	return true
end

function Story:RefreshLocks()
	for _, it in ipairs(World.Items) do
		if GATED[it.kind] and it.prompt and it.prompt.Parent then
			local ok = self:CanTake(it.kind)
			local t = ITEM_TEXT[it.kind]
			it.prompt.ActionText = ok and t[2] or "Locked"
			it.prompt.HoldDuration = (ok and it.kind == "fuse") and 1 or 0
		end
	end
end

function Story:Collect(it)
	local k = it.kind
	if GATED[k] and not Story:CanTake(k) then
		UI:Toast("Not yet. Finish your current objective first.")
		Audio:Play("click", { caption = false })
		return
	end
	if k == "note" or k == "page" or k == "computer" then
		local n = NOTES[it.note]
		local body = n.body
		if it.note == "p3" then
			body = "CURRENT ADMISSION — WARD 07\nPatient: " .. string.upper(LP.DisplayName) ..
				"\nAdmitted 31 days ago.\n\n\"He always thinks it is the first time.\"\n\nDr. Vesper does not chase you to hurt you. He chases your scream, to silence it. Perhaps, this time, he will hear you back."
		end
		UI:ShowNote(n.title, body, function()
			if k == "page" and not it.read then
				it.read = true
				S.pages = S.pages + 1
				UI:Toast("Medical chart " .. S.pages .. "/" .. PAGES_TOTAL)
			end
			if it.id == "note1" and S.phase == 0 then
				Story:SetPhase(1)
				UI:SetObjective("Find " .. FUSES_NEEDED .. " fuses and restore the generator (0/" .. FUSES_NEEDED .. ")", 0, FUSES_NEEDED)
				UI:Say("Pharmacy. X-Ray. Ward 07. Theatre 2 upstairs. The furnace below.", 4)
			end
			if k ~= "computer" and not it.taken then
				it.taken = true
				Inv:Pickup(it, it.note)
			end
		end)
		return
	end
	Audio:Play("pickup", { volume = 0.6 })
	Inv:Pickup(it)
	if k == "weapon" then
		S.hasWeapon = true
		UI:Say("You feel the urge to kill her", 4.5, COL.red2)
		Audio:Play("scream", { volume = 1, priority = true, caption = "[an ear-splitting scream]" })
		UI:Whisper("You will die")
		Monster.baseState = "Stalking"
		S.phase = math.max(S.phase, 1)
		Monster:StartHunt()
		Fear:Bump(0.45)
	elseif k == "battery" then
		UI:Toast("Battery stored. Equip it and click to recharge.")
	elseif k == "fuse" then
		S.fusesPicked, S.fusesHeld = S.fusesPicked + 1, S.fusesHeld + 1
		UI:Toast("Fuse " .. S.fusesPicked .. "/" .. FUSES_NEEDED)
		local n = S.fusesPicked
		if n < FUSES_NEEDED then
			UI:SetObjective("Find " .. FUSES_NEEDED .. " fuses and restore the generator (" .. n .. "/" .. FUSES_NEEDED .. ")", n, FUSES_NEEDED)
		else
			UI:SetObjective("Bring the fuses to the box in the Generator Room", FUSES_NEEDED, FUSES_NEEDED)
		end
		if n == 1 then
			Story:SetPhase(2)
			UI:Whisper("...he woke up.")
		elseif n == 3 then
			for _, l in ipairs(Lamps.list) do if l.on then Lamps:Flicker(l, 1.5, true) end end
			UI:Whisper("...he heard the fuse.")
			Fear:Bump(0.4)
			VFX:Shake(0.05)
		end
	elseif k == "key" then
		S.hasKey = true
		World.Doors["F2N3"].locked = false
		UI:Toast("Brass key: Director's Office")
		UI:Whisper("...the door at the end of the hall...")
		Fear:Bump(0.2)
		Story:UpdateObjective()
	elseif k == "card" then
		S.hasCard = true
		Story:SetPhase(4)
		UI:Say("The Night Shifter now runs faster.", 3.5, COL.red2)
		UI:Glitch(0.5)
		Fear:Bump(0.4)
		Story:UpdateObjective()
	elseif k == "code" then
		S.hasCode = true
		Story:SetPhase(5)
		UI:Say("He knows the codes are gone. He is running even faster.", 4, COL.red2)
		UI:Glitch(0.6)
		Fear:Bump(0.5)
		later(8, function() Monster:StartHunt() end)
		Story:UpdateObjective()
	elseif k == "cutters" then
		S.hasCutters = true
		UI:Say("The chains will sing when you cut them. He will hear.", 4, COL.red2)
		UI:Glitch(0.5)
		Fear:Bump(0.4)
		Story:UpdateObjective()
	end
end

function Story:InsertFuses()
	if S.fusesHeld <= 0 then UI:Toast("You have no fuses.") return end
	local heldNow = S.fusesHeld
	Inv:Remove("fuse", heldNow)
	S.fusesIn, S.fusesHeld = S.fusesIn + heldNow, 0
	World:FillFuse(S.fusesIn)
	Audio:Play("fuse", { pos = World.fuseBox.Position, volume = 0.8, priority = true })
	if World.fuseSparks then World.fuseSparks:Emit(40) end
	Game:Noise(0.9, World.fuseBox.Position)
	if S.fusesIn >= FUSES_NEEDED then
		self:PowerOn()
	else
		UI:Toast("Fuses inserted: " .. S.fusesIn .. "/" .. FUSES_NEEDED)
	end
end

function Story:PowerOn()
	if S.power or S.cinematic then return end
	S.cinematic = true
	local id = S.runId
	task.spawn(function()
		for _, l in ipairs(Lamps.list) do Lamps:Set(l, false) end
		Audio:Duck(0)
		UI:SetObjective("...")
		task.wait(2.6)
		if not isRun(id) then return end
		S.power = true
		Env:SetMood(true)
		for _, l in ipairs(Lamps.list) do Lamps:SetColor(l, Color3.fromRGB(255, 50, 40), 1.5) Lamps:Set(l, rng:NextNumber() < 0.55) end
		World.Doors["S4"].locked = false
		World.Doors["B1N2"].locked = false
		Audio:Duck(1)
		Audio:Play("power_up", { volume = 0.9, priority = true })
		UI:Glitch(0.8)
		UI:Say("Power is back. Something in the building woke up.", 4, COL.red2)
		Story:SetPhase(3)
		UI:SetObjective("Get the access card from the Morgue")
		S.cinematic = false
		task.wait(14)
		if not isRun(id) then return end
		Monster.baseState = "Stalking"
		local pp = Player:Pos()
		if pp then
			Monster:Relocate(pp)
			Monster:StartHunt()
		end
	end)
end

function Story:TryExit()
	if not S.hasCard then
		UI:Toast("The card reader has no access power.")
		Audio:Play("click", { caption = false })
		return
	end
	if not S.hasCode then
		UI:Toast("Access denied. Override codes required.")
		Audio:Play("click", { caption = false })
		Game:Noise(0.4, World.exit.pos)
		return
	end
	if not S.hasCutters then
		UI:Toast("The gate is chained. You need bolt cutters.")
		Audio:Play("click", { caption = false })
		Game:Noise(0.3, World.exit.pos)
		return
	end
	Game:Noise(1, World.exit.pos)
	Monster:StartHunt()
	UI:ShowChoice(S.pages >= PAGES_TOTAL)
end

function Story:Ending(kind)
	if S.ending then return end
	UI:HideChoice()
	S.ending, S.cinematic = "win", true
	local id = S.runId
	task.spawn(function()
		local pp = Player:Pos()
		if kind == "B" and pp then
			Game:Noise(1, pp)
			Audio:Duck(0.1)
			UI:Say(LP.DisplayName .. "!", 3, COL.red2)
			Audio:Play("scream", { volume = 0.5, caption = false })
			task.wait(2.5)
			if not isRun(id) then return end
			Monster:SetState("Special")
			Monster.pos = ground(pp + lookFlat() * 8)
