function Game:FireWeapon()
	if not S.running or S.cinematic or S.ending or not S.hasWeapon or S.elenaDead then return end
	local pp = Player:Pos()
	if not pp or Monster.state == "Dormant" then UI:Toast("There is nothing to shoot.") return end
	local d = fdist(pp, Monster.pos)
	if d > 90 or not Monster:InView(pp) then
		Audio:Play("metal_clang", { volume = 0.25, caption = false })
		UI:Toast("The shot disappears into the dark.")
		return
	end
	S.weaponShots = S.weaponShots + 1
	Audio:Play("door_slam", { volume = 0.8, priority = true, caption = false })
	VFX:Shake(0.08, 0.2)
	Fear:Bump(0.12)
	UI:Toast("Elena hit " .. S.weaponShots .. "/5")
	Monster:SetState("Hunting")
	Monster.lastSeen = ground(pp)
	Monster.lostT = 0
	Monster.fadeTarget = 1
	if S.weaponShots >= 5 then self:StartKillEnding() end
end

function Game:AdminPursuit()
	if not S.running or S.ending then return end
	Monster.baseState = "Stalking"
	S.phase = math.max(S.phase, 1)
