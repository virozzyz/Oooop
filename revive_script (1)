local function fadeText(label, token, text, dur, color)
	label.Text = text
	if color then label.TextColor3 = color end
	label.TextTransparency = 1
	tween(label, 0.4, { TextTransparency = 0 })
	UI.tokens[token] = UI.tokens[token] + 1
	local id = UI.tokens[token]
	task.delay(dur, function()
		if UI.tokens[token] == id and label.Parent then tween(label, 0.6, { TextTransparency = 1 }) end
	end)
end

