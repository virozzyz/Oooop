function World:BuildStairs()
	local los = self.LOSF
	local XA, XB, W = -8, -34, 6
	local function ramp(z, y1, y2)
		local p1, p2 = P(XA, y1, z), P(XB, y2, z)
		local mid = (p1 + p2) / 2
		local len = (p2 - p1).Magnitude
		local cf = CFrame.lookAt(mid, p2)
		mk(los, "Ramp", V(W, 0.8, len), cf * CFrame.new(0, -0.4, 0), Color3.fromRGB(56, 58, 56), Enum.Material.Concrete)
		local n = math.floor(len / 1.6)
		for i = 0, n - 1 do
			local a = p1:Lerp(p2, (i + 0.5) / n)
			dk(self.Decor, "Step", V(W - 0.4, 0.4, math.abs(XA - XB) / n * 0.95), CFrame.new(a.X, a.Y + 0.15, a.Z), Color3.fromRGB(86, 86, 80), Enum.Material.Concrete, false)
		end
		for _, sx in ipairs({ -W / 2, W / 2 }) do
			dk(self.Decor, "Rail", V(0.3, 3.2, len), cf * CFrame.new(sx, 1.6, 0), Color3.fromRGB(52, 56, 58), Enum.Material.Metal, false)
		end
	end
	ramp(0, 0, FH)
	ramp(-14, FH, 2 * FH)
	ramp(14, 0, -FH)
	local rc = Color3.fromRGB(52, 56, 58)
	for fi, holes in pairs(HOLES) do
		for _, h in ipairs(holes) do
			local fy = fi * FH
			local function rail(x1, x2, z1, z2)
				dk(self.Decor, "HoleRail", V(x2 - x1 + 0.3, 3.4, z2 - z1 + 0.3), C((x1 + x2) / 2, fy + 1.7, (z1 + z2) / 2), rc, Enum.Material.Metal, false)
			end
			rail(h.x1, h.x2, h.z1, h.z1)
			rail(h.x1, h.x2, h.z2, h.z2)
			if h.open == "E" then rail(h.x1, h.x1, h.z1, h.z2) else rail(h.x2, h.x2, h.z1, h.z2) end
		end
	end
end

