function World:FillFuse(count)
	self.fuseFilled = self.fuseFilled or 0
	if not self.fuseSockets then return end
	for i = self.fuseFilled + 1, math.min(count, 5) do
		local pos = self.fuseSockets[i]
		if pos then
			Kit.realize(Kit.SPECS.fuse(), self.Decor, CFrame.new(pos) * CFrame.Angles(math.pi / 2, 0, 0), "world", 0.5)
			if self.fuseLeds[i] then self.fuseLeds[i].Color = Color3.fromRGB(60, 255, 120) end
		end
	end
	self.fuseFilled = math.min(count, 5)
end

