local Store = {}
local function hashStr(s)
	local h = 5381
	for i = 1, #s do h = (h * 33 + s:byte(i)) % 4294967296 end
	return h
end

function Store:path(kind) return AUDIO_FOLDER .. "/" .. kind .. "_" .. tostring(LP.UserId) .. ".dat" end
function Store:ok() return type(isfile) == "function" and type(readfile) == "function" and type(writefile) == "function" end
function Store:pack(payload) return payload .. "|" .. hashStr(payload .. tostring(LP.UserId) .. "p07") end
function Store:unpack(d)
	if type(d) ~= "string" then return nil end
	local payload, h = d:match("^(.-)|(%d+)$")
	if payload and tonumber(h) == hashStr(payload .. tostring(LP.UserId) .. "p07") then return payload end
	return nil
end
function Store:read(kind)
	if self:ok() then
		local okf, ex = pcall(isfile, self:path(kind))
		if okf and ex then
			local ok, d = pcall(readfile, self:path(kind))
			if ok then return d end
		end
		return nil
	end
	genv.__P07MEM = genv.__P07MEM or {}
	return genv.__P07MEM[kind]
end
function Store:write(kind, data)
	if self:ok() then
		pcall(function()
			if type(isfolder) == "function" and type(makefolder) == "function" and not isfolder(AUDIO_FOLDER) then makefolder(AUDIO_FOLDER) end
		end)
		pcall(writefile, self:path(kind), data)
	else
		genv.__P07MEM = genv.__P07MEM or {}
		genv.__P07MEM[kind] = data
	end
end
function Store:delete(kind)
	if self:ok() then
		if type(delfile) == "function" then pcall(delfile, self:path(kind)) else pcall(writefile, self:path(kind), "") end
	end
	if genv.__P07MEM then genv.__P07MEM[kind] = nil end
end

function UGC:Load()
	self.A, self.B, self.C, self.K, self.claimed, self.sent = false, false, false, false, false, false
	local p = Store:unpack(Store:read("ugc"))
	if p then
		self.A = p:find("A=1", 1, true) ~= nil
		self.B = p:find("B=1", 1, true) ~= nil
			self.C = p:find("C=1", 1, true) ~= nil
			self.K = p:find("K=1", 1, true) ~= nil
	end
	local c = Store:unpack(Store:read("claim"))
	if c then
		self.claimed = true
		self.sent = c:find("sent=1", 1, true) ~= nil
	end
end

function UGC:Save()
	Store:write("ugc", Store:pack("A=" .. (self.A and 1 or 0) .. ";B=" .. (self.B and 1 or 0) .. ";C=" .. (self.C and 1 or 0) .. ";K=" .. (self.K and 1 or 0)))
end

function UGC:Record(kind)
	if self.claimed then return end
	if kind == "A" then self.A = true elseif kind == "B" then self.B = true elseif kind == "C" then self.C = true end
	if self.A and self.B then self.K = true end
	self:Save()
	UI:RefreshUGC()
end

function UGC:WeaponUnlocked() return self.A and self.B end
function UGC:AllEndings() return self.A and self.B and self.C end

function UGC:Summary()
	return "UGC: ESCAPE " .. (self.A and "DONE" or "LOCKED") .. "  ·  TRUE " .. (self.B and "DONE" or "LOCKED") .. "  ·  KILL HER " .. (self.C and "DONE" or "LOCKED")
end

function UGC:Claim()
	if self.claimed or not (self.A and self.B) then return end
	self.claimed = true
	Store:write("claim", Store:pack("claimed=1;sent=0"))
	UI.el.ugc.Visible = false
	if S.running or Player.saved then Game:StopRun() end
	UI:ShowClaim()
end

function UGC:Post(name)
	local HttpService = game:GetService("HttpService")
	local id = LP.UserId
	local profile = "https://www.roblox.com/users/" .. id .. "/profile"
	local dn, un = LP.DisplayName, LP.Name
	local payload = {
		username = "Saint Helen Hospital",
		content = "🩸 **" .. dn .. "** has survived **NIGHT SHIFT 07** — <" .. profile .. ">",
		allowed_mentions = { parse = {} },
		embeds = { {
			title = "🏆 ALL ENDINGS COMPLETE — UGC CLAIMED",
			url = profile,
			description = "## A new survivor walks out of Saint Helen\n**" .. dn .. "** (@" .. un .. ") escaped the hospital, heard the scream and called their own name.\n\n🔗 [Open Roblox profile](" .. profile .. ")",
			color = 0xB91C1C,
			fields = {
				{ name = "👤 Roblox user", value = "[" .. dn .. " (@" .. un .. ")](" .. profile .. ")", inline = true },
				{ name = "🆔 Roblox ID", value = "`" .. id .. "`", inline = true },
				{ name = "💬 Discord", value = "`" .. name .. "`", inline = true },
				{ name = "📜 Endings", value = "✅ ESCAPE Ending\n✅ TRUE Ending\n✅ KILL HER Ending", inline = false },
				{ name = "🌐 Profile link", value = profile, inline = false },
			},
			thumbnail = { url = "https://www.roblox.com/headshot-thumbnail/image?userId=" .. id .. "&width=150&height=150&format=png" },
			footer = { text = "NIGHT SHIFT 07 · Saint Helen Hospital" },
			timestamp = os.date("!%Y-%m-%dT%H:%M:%SZ"),
		} },
	}
	local json = HttpService:JSONEncode(payload)
	local req = { Url = CONFIG.Webhook, Method = "POST", Headers = { ["Content-Type"] = "application/json" }, Body = json }
	local fns = {}
	if type(request) == "function" then fns[#fns + 1] = request end
	if type(http_request) == "function" then fns[#fns + 1] = http_request end
	if type(syn) == "table" and type(syn.request) == "function" then fns[#fns + 1] = syn.request end
	if type(http) == "table" and type(http.request) == "function" then fns[#fns + 1] = http.request end
	if type(fluxus) == "table" and type(fluxus.request) == "function" then fns[#fns + 1] = fluxus.request end
	for _, f in ipairs(fns) do
		local ok, res = pcall(f, req)
		if ok then
			if type(res) ~= "table" then return true end
			if res.Success == true or (type(res.StatusCode) == "number" and res.StatusCode >= 200 and res.StatusCode < 300) then return true end
		end
	end
	local ok2, res2 = pcall(function() return HttpService:RequestAsync(req) end)
	if ok2 and type(res2) == "table" and res2.Success then return true end
	local ok3 = pcall(function() return HttpService:PostAsync(CONFIG.Webhook, json, Enum.HttpContentType.ApplicationJson) end)
	return ok3
end

function UGC:Send()
	if self.sending or self.sent then return end
	local box = UI.el.claimBox
	local name = ((box.Text or ""):gsub("^%s+", "")):gsub("%s+$", "")
	name = name:gsub("`", "'"):sub(1, 64)
	if name == "" then
		UI.el.claimStatus.Text = "Write your Discord user first."
		UI.el.claimStatus.TextColor3 = COL.red2
		return
	end
	self.sending = true
	UI.el.claimStatus.Text = "Sending..."
	UI.el.claimStatus.TextColor3 = COL.dim
	task.spawn(function()
		local ok = UGC:Post(name)
		UGC.sending = false
		if ok then
			UGC.sent = true
			Store:write("claim", Store:pack("claimed=1;sent=1"))
		end
		UI:RefreshClaim(ok and "ok" or "fail")
	end)
end

