function Inv:Use(kind)
	if not S.running or S.paused or S.reading or S.cinematic or S.ending then return end
	local st = self.stacks[kind]
	if not st then return end
	local t = os.clock()
	if t - (self.lastUse or 0) < 0.6 then return end
	self.lastUse = t
	local d = self.live
	local meta = self.META[kind]
	if kind == "note" or kind == "page" then
		if #st.list == 0 then return end
		st.idx = (st.idx or 0) % #st.list + 1
		local title, body = Story:NoteBody(st.list[st.idx])
		UI:ShowNote(title .. "  (" .. st.idx .. "/" .. #st.list .. ")", body)
	elseif kind == "weapon" then
		Game:FireWeapon()
		return
	elseif kind == "battery" then
		if S.battery >= 99 then UI:Toast("The flashlight is already full.") return end
		if d then d.use = t end
		S.battery = math.min(100, S.battery + CONFIG.BatteryPickup)
		UI:Toast("Flashlight recharged +" .. CONFIG.BatteryPickup .. "%")
		Audio:Play("locker", { volume = 0.4, caption = false })
		task.delay(0.55, function() Inv:Remove("battery", 1) end)
	else
		if d then d.inspect = t end
		if meta.use then UI:Toast(meta.use) end
	end
end

function Inv:Update(dt)
	local d = self.live
	if not d or not d.tool or not d.tool.Parent or not d.tool.Parent:IsA("Model") then return end
	local t = os.clock()
	local a = clamp((t - (d.equipT or t)) / 0.45, 0, 1)
	local back = (1 - a) ^ 3
	local g = d.g0 * CFrame.new(0, -1.4 * back, 0.9 * back) * CFrame.Angles(0.9 * back, 0, 0)
	g = g * CFrame.new(0, math.sin(t * 1.7) * 0.035, 0) * CFrame.Angles(math.sin(t * 1.1) * 0.03, 0, math.sin(t * 0.9) * 0.02)
	if d.inspect and t - d.inspect < 0.9 then
		local k = (t - d.inspect) / 0.9
		g = g * CFrame.Angles(0, k * math.pi * 2, 0) * CFrame.new(0, math.sin(k * math.pi) * 0.25, 0)
	end
	if d.use and t - d.use < 0.55 then
		local k = (t - d.use) / 0.55
		g = g * CFrame.new(0, -1.3 * k, 0.4 * k) * CFrame.Angles(-1.0 * k, 0, 0)
	end
	d.tool.Grip = g
end

function Inv:Rebuild()
	task.spawn(function()
		local bp = LP:WaitForChild("Backpack", 8)
		if not bp then return end
		for _, kind in ipairs(self.order) do
			local st = self.stacks[kind]
			if st then
				if not st.tool or not st.tool:IsDescendantOf(game) then
					st.tool = self:MakeTool(kind)
					self:Retitle(st)
				end
				if st.tool.Parent == nil then st.tool.Parent = bp end
			end
		end
		self.equipped, self.live = nil, nil
		self:Refresh()
	end)
end

function Inv:Begin()
	self:End()
	pcall(function()
		self.cgPrev = StarterGui:GetCoreGuiEnabled(Enum.CoreGuiType.Backpack)
		StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
	end)
	self:SetVisible(true)
end

function Inv:End()
	for _, st in pairs(self.stacks) do pcall(function() st.tool:Destroy() end) end
	self.stacks, self.order, self.equipped, self.live = {}, {}, nil, nil
	if self.cgPrev ~= nil then
		pcall(function() StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, self.cgPrev) end)
		self.cgPrev = nil
	end
	self:Refresh()
end

function Game:WeaponAwaken()
