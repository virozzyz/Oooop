function Doors:Set(d, open, who, instant)
	if d.open == open then return end
	d.open = open
	local goal = open and d.openCF or d.closedCF
	if instant then
		d.part.CFrame = goal
	else
		tween(d.part, who == "slam" and 0.13 or 0.9, { CFrame = goal }, Enum.EasingStyle.Quad)
		if who == "slam" then
			Audio:Play("door_slam", { pos = d.pos, volume = 0.9, max = 140, priority = true })
		else
			Audio:Play("door_creak", { pos = d.pos, volume = who == "monster" and 0.5 or 0.55 })
		end
		if who == "player" then Game:Noise(open and 0.3 or 0.4, d.pos) end
	end
	if d.prompt then d.prompt.ActionText = open and "Close" or "Open" end
end

function World:MakeDoor(room)
	local z0 = room.side * 5
	local hinge = C(room.cx - 3, 4, z0)
	local part = mk(self.LOSF, "Door", V(6, 8, 0.6), hinge * CFrame.new(3, 0, 0), Color3.fromRGB(62, 46, 36), Enum.Material.Wood)
	local function weldDecor(size, off, color, mat, tr)
		local p = dk(self.Decor, "DoorDecor", size, part.CFrame * off, color, mat, false)
		p.Anchored = false
		p.Massless = true
		p.Transparency = tr or 0
		N("WeldConstraint", { Part0 = part, Part1 = p }, p)
		return p
	end
	weldDecor(V(2.4, 3.0, 0.7), CFrame.new(0, 1.6, 0), Color3.fromRGB(18, 26, 28), Enum.Material.Glass, 0.25)
	weldDecor(V(0.3, 0.3, 0.9), CFrame.new(2.4, -0.4, 0), Color3.fromRGB(170, 174, 178), Enum.Material.Metal)
	weldDecor(V(5.0, 1.4, 0.66), CFrame.new(0, -3.2, 0), Color3.fromRGB(70, 74, 78), Enum.Material.Metal)
	local fc = Color3.fromRGB(34, 28, 24)
	dk(self.Decor, "Frame", V(0.6, 8.4, 1.1), C(room.cx - 3.2, 4.2, z0), fc, Enum.Material.Wood, false)
	dk(self.Decor, "Frame", V(0.6, 8.4, 1.1), C(room.cx + 3.2, 4.2, z0), fc, Enum.Material.Wood, false)
	dk(self.Decor, "Frame", V(6.8, 0.6, 1.1), C(room.cx, 8.3, z0), fc, Enum.Material.Wood, false)
	local d = { part = part, room = room, open = false, locked = false, pos = P(room.cx, 4, z0),
		closedCF = hinge * CFrame.new(3, 0, 0),
		openCF = hinge * CFrame.Angles(0, -room.side * math.rad(100), 0) * CFrame.new(3, 0, 0) }
	d.prompt = self:Prompt(part, "Door", "Open", function()
		if d.locked then
			UI:Toast(d.lockMsg or "Locked.")
			Audio:Play("click", { pos = d.pos, caption = false })
			Game:Noise(0.15, d.pos)
			return
		end
		Doors:Set(d, not d.open, "player")
	end, { dist = 7 })
	d.prompt.RequiresLineOfSight = false
	self.DoorList[#self.DoorList + 1] = d
	self.Doors[room.id] = d
	return d
end

