function Anticheat:Flag(kind, w, setback)
	if S.ending then return end
	local now = os.clock()
	if self.last[kind] and now - self.last[kind] < 1.2 then return end
	self.last[kind] = now
	self.lastFlag = now
	self.strikes = self.strikes + w
	if setback and self.safeCF and Char.Root and Char.Root.Parent then
		Char.Root.CFrame = self.safeCF
		Char.Root.AssemblyLinearVelocity = Vector3.zero
	end
	self:Reset(0.5)
	if self.strikes >= CONFIG.CheatStrikes then
		Game:Cheat(kind)
		return
	end
	UI:Say("INTEGRITY WARNING: " .. kind, 3, COL.red2)
	UI:Glitch(0.6)
	Fear:Bump(0.45)
	VFX:Shake(0.1)
	Audio:Play("static", { volume = 0.8 })
	if S.phase >= 1 then Monster:StartHunt() end
end

function Anticheat:Overlap(pos)
	for _, p in ipairs(Workspace:GetPartBoundsInRadius(pos, 0.3, self.op)) do
		if SolidParts[p] then return true end
	end
	return false
end

function Anticheat:Move(hum, root, real)
	local pos = root.Position
	local prev = self.prev
	self.prev = pos
	local vel = root.AssemblyLinearVelocity
	if root.Anchored then
		self.anchT = self.anchT + real
		if self.anchT > 0.6 then
			self.anchT = 0
			root.Anchored = false
			self:Flag("Anchor / Freeze", 1, false)
			return
		end
	else
		self.anchT = 0
	end
	if vel.Y > 18 then
		self:Flag("Fly / InfJump", 1, true)
		return
	end
	if hum.FloorMaterial == Enum.Material.Air and math.abs(vel.Y) < 2.5 then
		self.airT = self.airT + real
		if self.airT > 0.9 then
			self.airT = 0
			self:Flag("Float / Fly", 1.5, true)
			return
		end
	else
		self.airT = math.max(0, self.airT - real * 2)
	end
	if prev then
		local d = pos - prev
		local dh = math.sqrt(d.X * d.X + d.Z * d.Z)
		local du = math.max(d.Y, 0)
		if math.sqrt(dh * dh + du * du) > 25 + 40 * real then
			self:Flag("Teleport", 2, true)
			return
		end
		if self:Overlap(pos) then
			self:Flag("Noclip", 2, true)
			return
		end
		if d.Magnitude > 0.05 then
			local hit = Workspace:Raycast(prev, d, self.rp2)
			if hit and SolidParts[hit.Instance] then
				self:Flag("Noclip", 2, true)
				return
			end
		end
		self.winT = self.winT + real
		self.winH = self.winH + dh
		self.winU = self.winU + du
		if self.winT >= 0.5 then
			local sh, su = self.winH / self.winT, self.winU / self.winT
			self.winT, self.winH, self.winU = 0, 0, 0
			if sh > (CONFIG.SprintSpeed + (S.perk and CONFIG.PerkSprint or 0)) * 1.2 then
				self:Flag("Speed / TPWalk", 1, true)
				return
			elseif su > 16 * (1 + (S.perk and CONFIG.PerkSprint or 0) / CONFIG.SprintSpeed) then
				self:Flag("Vertical speed", 1, true)
				return
			end
		end
	end
	self.safeT = self.safeT + real
	if self.safeT > 0.3 and hum.FloorMaterial ~= Enum.Material.Air and os.clock() - (self.lastFlag or 0) > 0.6 then
		self.safeT = 0
		self.safeCF = root.CFrame
	end
end

function Anticheat:Slow(hum, root)
	local e = Env.exp
	if e then
		local a, b = Lighting.Ambient, e.amb
		local bad = math.abs(a.R - b.R) + math.abs(a.G - b.G) + math.abs(a.B - b.B) > 0.05
			or Lighting.Brightness > 0.5 or Lighting.FogEnd > e.fog + 50 or Lighting.ExposureCompensation > 0.5
		if bad then self.lightBad = self.lightBad + 1 else self.lightBad = 0 end
		if self.lightBad >= 2 then
			self.lightBad = 0
			Env:SetMood(S.power)
			self:Flag("Fullbright / Fog", 1, false)
		end
	end
	local sol = self.solids
	if sol and #sol > 0 then
		for _ = 1, 30 do
			local p = sol[randi(1, #sol)]
			if not p.Parent or not p.CanCollide or p.Transparency > 0.1 then
				pcall(function() p.CanCollide = true p.Transparency = 0 end)
				self:Flag("Wall tamper / X-Ray", 2, true)
				break
			end
		end
	end
	local cam = Cam()
	if cam and not S.hidden and not S.ending then
		if cam.CameraType == Enum.CameraType.Scriptable then
			cam.CameraType = Enum.CameraType.Custom
			self:Flag("Freecam", 1, false)
		elseif (cam.CFrame.Position - root.Position).Magnitude > 9 then
			self:Flag("Camera / Freecam", 1, false)
		end
	end
	if LP.CameraMode ~= Enum.CameraMode.LockFirstPerson then
		pcall(function() LP.CameraMode = Enum.CameraMode.LockFirstPerson end)
		self:Flag("Camera mode", 1, false)
	end
end

function Anticheat:Update(dt)
	if not CONFIG.AntiCheat or not S.running or S.paused or S.ending then return end
	local hum, root = Char.Hum, Char.Root
	if not hum or not hum.Parent or not root or not root.Parent or not self.rp2 then return end
	local now = os.clock()
	local real = self.lastT and math.min(now - self.lastT, 1) or dt
	self.lastT = now
	self.strikes = math.max(0, self.strikes - real / 120)
	if self.grace > 0 then
		self.grace = self.grace - real
		self.prev = nil
		return
	end
	local ws = Player.lastWS
	if ws and math.abs(hum.WalkSpeed - ws) > 0.6 then
		hum.WalkSpeed = ws
		self:Flag("WalkSpeed", 1.5, false)
	end
	if hum.JumpPower > 0.5 or hum.JumpHeight > 0.5 then
		pcall(function() hum.JumpPower = 0 hum.JumpHeight = 0 end)
		self:Flag("JumpPower / InfJump", 1.5, false)
	end
	if math.abs(hum.HipHeight - self.hip) > 0.3 then
		hum.HipHeight = self.hip
		self:Flag("HipHeight / Float", 1, false)
	end
	if math.abs(Workspace.Gravity - self.gravity) > 2 then
		Workspace.Gravity = self.gravity
		self:Flag("Gravity", 1.5, false)
	end
	if hum.PlatformStand then
		hum.PlatformStand = false
		self:Flag("PlatformStand / Fly", 1, false)
	end
	local st = hum:GetState()
	local kind = (st == Enum.HumanoidStateType.Swimming and "Swim") or (st == Enum.HumanoidStateType.Climbing and "Climb / Spider")
		or (st == Enum.HumanoidStateType.Flying and "Fly") or (st == Enum.HumanoidStateType.Jumping and "InfJump")
	if kind then
		pcall(function() hum:ChangeState(Enum.HumanoidStateType.GettingUp) end)
		self:Flag(kind, 1.5, false)
	end
	for _, s in ipairs(AC_STATES) do
		if hum:GetStateEnabled(s) then
			pcall(function() hum:SetStateEnabled(s, false) end)
			self:Flag("State tamper", 1, false)
			break
		end
	end
	if S.ending then return end
	if S.hidden or S.camLock then
		self.prev = nil
		self.airT = 0
	else
		self:Move(hum, root, real)
	end
	self.slowT = self.slowT + real
	if self.slowT >= 1 then
		self.slowT = 0
		self:Slow(hum, root)
	end
end

function Game:Cheat(kind)
