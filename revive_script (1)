function World:Geometry(def)
	local los = self.LOSF
	local len = def.len
	local function wallX(x1, x2, z) return mk(los, "W", V(x2 - x1, H, WT), C((x1 + x2) / 2, H / 2, z), WALLC) end
	local function wallZ(z1, z2, x) return mk(los, "W", V(WT, H, math.abs(z2 - z1)), C(x, H / 2, (z1 + z2) / 2), WALLC) end
	local slabColor = def.fi == -1 and Color3.fromRGB(30, 32, 32) or Color3.fromRGB(38, 40, 40)
	for _, r in ipairs(slabRects(-WEST - 1, len + 2, -BACK - 2, BACK + 2, HOLES[def.fi] or {})) do
		mk(los, "Slab", V(r[2] - r[1], 2, r[4] - r[3]), C((r[1] + r[2]) / 2, -1, (r[3] + r[4]) / 2), slabColor, Enum.Material.Slate)
	end
	if def.fi == 2 then
		mk(los, "Roof", V(len + WEST + 3, 2, BACK * 2 + 4), C((len - WEST + 1) / 2, H + 1, 0), Color3.fromRGB(34, 36, 36))
	end
	for _, d2 in ipairs(FLOOR_DEFS) do
		if d2.fi == def.fi + 1 and d2.len < def.len then
			local x1, x2 = d2.len + 2, def.len + 2
			mk(los, "Ceiling", V(x2 - x1, 2, BACK * 2 + 4), C((x1 + x2) / 2, H + 1, 0), Color3.fromRGB(34, 36, 36))
		end
	end
	for _, side in ipairs({ 1, -1 }) do
		local z, prev = side * 5, 0
		for _, spec in ipairs(def.specs) do
			if spec.side == side then
				wallX(prev, spec.cx - 3, z)
				mk(los, "Lintel", V(6, H - 8, WT), C(spec.cx, 8 + (H - 8) / 2, z), WALLC)
				prev = spec.cx + 3
			end
		end
		wallX(prev, len, z)
		wallX(-0.5, len + 0.5, side * BACK)
		for k = 1, def.ncol - 1 do wallZ(side * 5, side * BACK, 30 * k) end
	end
	wallZ(-BACK - 0.5, -3, 0)
	wallZ(3, BACK + 0.5, 0)
	mk(los, "Lintel", V(WT, H - 8, 6), C(0, 8 + (H - 8) / 2, 0), WALLC)
	if def.fi == 0 then
		wallZ(-BACK - 0.5, -3, len)
		wallZ(3, BACK + 0.5, len)
		mk(los, "Lintel", V(WT, H - 8, 6), C(len, 8 + (H - 8) / 2, 0), WALLC)
		sign(self.Decor, "EXIT", P(len - 1.4, 9.3, 0), V(-1, 0, 0), V(5, 1.1, 0.15))
	else
		wallZ(-BACK - 0.5, BACK + 0.5, len)
	end
	wallZ(-AZ, AZ, -WEST)
	wallX(-WEST, 0, AZ)
	wallX(-WEST, 0, -AZ)
	sign(self.Decor, def.label, P(-WEST + 0.6, 8, 0), V(1, 0, 0), V(10, 2, 0.15))
	for i = 1, math.floor(len / 16) do
		local x, z = rand(8, len - 8), rand(-3.2, 3.2)
		local s = dk(self.Decor, "Stain", V(0.05, rand(1.5, 3.2), rand(1.5, 3.2)), C(x, 0.03, z) * CFrame.Angles(0, 0, math.pi / 2), Color3.fromRGB(70, 8, 8), Enum.Material.SmoothPlastic, false)
		s.Shape = Enum.PartType.Cylinder
		s.Transparency = 0.35
	end
end

function World:BuildGraffiti(def)
	local words = { "SHHH", "HE HEARS YOU", "DAY 30", "DO NOT SCREAM", "07", "I WAS HERE 30 TIMES", "HE IS BLIND", "DON'T RUN",
