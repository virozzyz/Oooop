function UI:HeartUpdate(dt, phase, bpm, near)
	local e = self.el
	if not e.hbBars then return end
	self.hbAcc = (self.hbAcc or 0) + dt
	while self.hbAcc >= 0.04 do
		self.hbAcc = self.hbAcc - 0.04
		table.remove(e.hbBuf, 1)
		e.hbBuf[#e.hbBuf + 1] = ecg(phase)
	end
	local col = COL.dim:Lerp(COL.red2, clamp(near * 1.4, 0, 1))
	for i, b in ipairs(e.hbBars) do
		local v = e.hbBuf[i]
		b.Size = UDim2.new(0, 3, 0, math.max(2, math.abs(v) * 34))
		b.Position = UDim2.new(0, 8 + (i - 1) * 5, 0, 58 - v * 17)
		b.BackgroundColor3 = col
	end
	e.hbBpm.Text = tostring(math.floor(bpm + 0.5)) .. " BPM"
	e.hbBpm.TextColor3 = col
	e.hbHeart.BackgroundColor3 = col
	e.hbWarn.Text = (S.holdBreath and "holding breath...") or ((near > 0.55) and "HOLD YOUR BREATH" or "")
end

