function Player:Setup()
	local hum, root, cam = Char.Hum, Char.Root, Cam()
	if not self.saved then
		self.saved = { cf = root.CFrame, ws = hum.WalkSpeed, jp = hum.JumpPower, jh = hum.JumpHeight, co = hum.CameraOffset,
			fov = cam.FieldOfView, mode = LP.CameraMode, min = LP.CameraMinZoomDistance, max = LP.CameraMaxZoomDistance, ctype = cam.CameraType }
	end
	pcall(function() LP.CameraMode = Enum.CameraMode.LockFirstPerson end)
	pcall(function() hum.JumpPower = 0 hum.JumpHeight = 0 end)
	pcall(function() hum.MaxSlopeAngle = 89 end)
	cam.CameraType = Enum.CameraType.Custom
	self:BuildFlash()
	self:Teleport(CFrame.lookAt(P(6, 3.5, 0), P(60, 3.5, 0)))
end

function Player:Teleport(cf)
	local root = Char.Root
	if root and root.Parent then
		root.Anchored = false
		root.CFrame = cf
		root.AssemblyLinearVelocity = Vector3.zero
		Anticheat:Reset(1)
	end
end

function Player:Restore()
	local sv = self.saved
	self.saved = nil
	S.camLock = false
	self.flash, self.flashPart = nil, nil
	local hum, root, cam = Char.Hum, Char.Root, Cam()
	if not sv then return end
	if root and root.Parent then root.Anchored = false root.CFrame = sv.cf root.AssemblyLinearVelocity = Vector3.zero end
	if hum and hum.Parent then
		pcall(function() hum.WalkSpeed = sv.ws hum.JumpPower = sv.jp hum.JumpHeight = sv.jh hum.CameraOffset = sv.co end)
	end
	pcall(function() LP.CameraMode = sv.mode LP.CameraMaxZoomDistance = sv.max LP.CameraMinZoomDistance = sv.min end)
	if cam then cam.CameraType = sv.ctype cam.FieldOfView = sv.fov end
end

