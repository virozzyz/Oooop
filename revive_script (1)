function Nav:Build()
	self.nodes, self.adj = {}, {}
	local function node(id, x, y, z) self.nodes[id] = { id = id, pos = Vector3.new(O.X + x, O.Y + y, O.Z + z) } self.adj[id] = {} end
	local function link(a, b) table.insert(self.adj[a], b) table.insert(self.adj[b], a) end
	for _, def in ipairs(FLOOR_DEFS) do
		local p, fy = def.p, def.fi * FH
		node(p .. "C0", 6, fy, 0)
		for i = 1, def.ncol do node(p .. "C" .. i, 15 + 30 * (i - 1), fy, 0) end
		node(p .. "CE", def.len - 6, fy, 0)
		link(p .. "C0", p .. "C1")
		for i = 1, def.ncol - 1 do link(p .. "C" .. i, p .. "C" .. (i + 1)) end
		link(p .. "C" .. def.ncol, p .. "CE")
		for i = 1, def.ncol do
			local x = 15 + 30 * (i - 1)
			for _, s in ipairs({ { "N", 1 }, { "S", -1 } }) do
				local a, b = p .. s[1] .. i .. "a", p .. s[1] .. i .. "b"
				node(a, x, fy, s[2] * 10)
				node(b, x, fy, s[2] * 26)
				link(p .. "C" .. i, a)
				link(a, b)
			end
		end
		node(p .. "AT", -1, fy, 8)
		node(p .. "LD", -47, fy, 8)
		link(p .. "AT", p .. "C0")
		link(p .. "AT", p .. "LD")
	end
	node("RAlo", -7, 0, 0) node("RAhi", -35, FH, 0)
	link("RAlo", "RAhi") link("RAlo", "AT") link("RAhi", "F1LD")
	node("RBlo", -7, FH, -14) node("RBhi", -35, 2 * FH, -14)
	link("RBlo", "RBhi") link("RBlo", "F1AT") link("RBhi", "F2LD")
	node("RClo", -7, 0, 14) node("RChi", -35, -FH, 14)
	link("RClo", "RChi") link("RClo", "AT") link("RChi", "B1LD")
end

function Nav:Path(a, b)
	if a == b then return { a } end
	local dist, prev, done = {}, {}, {}
	for id in pairs(self.nodes) do dist[id] = math.huge end
	dist[a] = 0
	while true do
		local u, best = nil, math.huge
		for id, d in pairs(dist) do
			if not done[id] and d < best then u, best = id, d end
		end
		if not u or u == b then break end
		done[u] = true
		for _, v in ipairs(self.adj[u]) do
			local nd = best + fdist(self.nodes[u].pos, self.nodes[v].pos)
			if nd < dist[v] then dist[v] = nd prev[v] = u end
		end
	end
	if dist[b] == math.huge then return { a, b } end
	local path, cur = {}, b
	while cur do
		table.insert(path, 1, cur)
		cur = prev[cur]
	end
	return path
end

function Nav:Nearest(pos, needLOS)
	local best, bd, any, ad = nil, math.huge, nil, math.huge
	local fy = flY(pos.Y)
	for id, n in pairs(self.nodes) do
		local d = fdist(n.pos, pos)
		if d < ad then any, ad = id, d end
		if needLOS and d < bd and World:LOS(n.pos + V(0, 3.5, 0), V(pos.X, fy + 3, pos.Z)) then best, bd = id, d end
	end
	return best or any
end

