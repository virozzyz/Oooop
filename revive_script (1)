function World:Prompt(part, objText, actionText, cb, o)
	o = o or {}
	local pp = N("ProximityPrompt", { ObjectText = objText, ActionText = actionText, HoldDuration = o.hold or 0,
		MaxActivationDistance = o.dist or 7.5, RequiresLineOfSight = true, Exclusivity = Enum.ProximityPromptExclusivity.OnePerButton,
		KeyboardKeyCode = Enum.KeyCode.E }, part)
	pp.Triggered:Connect(function()
		if not S.running or S.paused or S.reading or S.cinematic or S.ending then return end
		if S.hidden and not o.hidden then return end
		safe("prompt", cb, pp)
	end)
	return pp
end

