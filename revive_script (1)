local function shiftCands(pp)
	local out, look = {}, Cam().CFrame.LookVector
	for _, p in ipairs(World.Props) do
		if p.model.Parent then
			local pos = p.model:GetPivot().Position
			local d = fdist(pos, pp)
			local to = V(pos.X - pp.X, 0, pos.Z - pp.Z)
			if d > 14 and d < 55 and to.Magnitude > 0 and look:Dot(to.Unit) < 0.2 then out[#out + 1] = p end
		end
	end
	return out
end
