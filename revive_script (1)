function World:BuildLockers(def)
	local function corridor(x, side)
		local z = side * (5 - WT / 2 - LD / 2)
		self:MakeLocker(C(x, LH / 2, z) * CFrame.Angles(0, side > 0 and 0 or math.pi, 0))
	end
	for k = 1, def.ncol - 1 do corridor(30 * k, (k % 2 == 1) and 1 or -1) end
	for _, b in ipairs(BACKLOCK[def.p]) do
		local r = self.RoomById[def.p .. b[1]]
		if r then
			local z = r.side * (BACK - WT / 2 - LD / 2)
			self:MakeLocker(C(r.cx + b[2], LH / 2, z) * CFrame.Angles(0, r.side > 0 and 0 or math.pi, 0))
		end
	end
end

function World:MakeLamp(x, z, room, def)
	local part = dk(self.Decor, "Lamp", V(3, 0.3, 1), C(x, H - 0.35, z), Color3.fromRGB(30, 30, 30), Enum.Material.Metal, false)
	dk(self.Decor, "LampHousing", V(3.5, 0.2, 1.5), C(x, H - 0.15, z), Color3.fromRGB(18, 18, 20), Enum.Material.Metal, false)
	local light = N("PointLight", { Range = 36, Brightness = 2, Color = Color3.fromRGB(255, 226, 180), Enabled = false, Shadows = false }, part)
	local l = { part = part, light = light, on = false, room = room, pos = part.Position, color = Color3.fromRGB(255, 222, 170), busy = false,
		floor = def.fi, base = 2 }
	Lamps.list[#Lamps.list + 1] = l
	if room then room.lamps[#room.lamps + 1] = l end
	return l
end

function World:BuildLamps(def)
	for x = 10, def.len - 10, 20 do
		local l = self:MakeLamp(x, 0, nil, def)
		l.corridor = true
	end
	for _, z in ipairs({ 0, 14, -14 }) do
		local a = self:MakeLamp(-27, z, nil, def)
		a.atrium = true
	end
	for _, r in ipairs(def.rooms) do self:MakeLamp(r.cx, r.side * ROOMC, r, def) end
	for _, l in ipairs(Lamps.list) do
		if l.floor == def.fi then
			local chance = l.corridor and 0.55 or (l.atrium and 0.6 or 0.25)
			if def.fi == -1 then chance = math.max(chance, 0.7) end
			local on = rng:NextNumber() < chance
			if def.fi == 0 and l.corridor and math.abs(l.pos.X - O.X - 10) < 0.5 then on = true end
			if def.fi == -1 and not l.atrium then l.unstable = true end
			if l.corridor and rng:NextNumber() < 0.3 then l.unstable = true end
			Lamps:Set(l, on)
			if def.fi ~= 0 then l.light.Enabled = false end
		end
	end
end

function Lamps:Set(l, on)
	if CONFIG.PureDark or l.broken then on = false end
	l.on = on
	l.light.Enabled = on
	l.part.Material = on and Enum.Material.Neon or Enum.Material.Metal
	l.part.Color = on and l.color or Color3.fromRGB(30, 30, 30)
end

function Lamps:SetColor(l, color, brightness)
	l.color = color
	l.light.Color = color
	if brightness then l.light.Brightness = brightness l.base = brightness end
	if l.on then l.part.Color = color end
end

function Lamps:Flicker(l, dur, endState)
	if l.busy then return end
	l.busy = true
	local id = S.runId
	task.spawn(function()
		local t0 = os.clock()
		while os.clock() - t0 < dur and isRun(id) do
			self:Set(l, rng:NextNumber() > 0.45)
			task.wait(rand(0.04, 0.16))
		end
		if isRun(id) then self:Set(l, endState) end
		l.busy = false
	end)
end

Lamps.eventT = 4

function Lamps:Break(l)
	if l.busy or l.broken then return end
	Audio:Play("flicker", { pos = l.pos, volume = 0.6 })
	self:Flicker(l, 0.9, false)
	later(1.0, function()
		l.broken = true
		self:Set(l, false)
		Audio:Play("metal_clang", { pos = l.pos, volume = 0.35 })
		local pe = N("ParticleEmitter", { Rate = 0, Lifetime = NumberRange.new(0.3, 0.8), Speed = NumberRange.new(6, 14),
			SpreadAngle = Vector2.new(60, 60), Acceleration = V(0, -40, 0), LightEmission = 1, Color = ColorSequence.new(Color3.fromRGB(255, 210, 120)),
			Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.25), NumberSequenceKeypoint.new(1, 0) }),
			EmissionDirection = Enum.NormalId.Bottom }, l.part)
		pe:Emit(26)
	end)
end

function Lamps:Tick(dt)
	self.eventT = self.eventT - dt
	if self.eventT > 0 then return end
	self.eventT = rand(2.5, 6)
	local pp = Player:Pos()
	if not pp then return end
	local c = {}
	for _, l in ipairs(self.list) do
		if l.on and not l.busy and not l.broken and fdist(l.pos, pp) < 70 then c[#c + 1] = l end
	end
	if #c == 0 then return end
	local l = pick(c)
	if rng:NextNumber() < 0.22 then
		self:Break(l)
	else
		Audio:Play("flicker", { pos = l.pos, volume = 0.45 })
		self:Flicker(l, rand(0.4, 1.6), true)
	end
end

function Lamps:Near(pos, radius, onlyOn)
	local out = {}
	for _, l in ipairs(self.list) do
		if (not onlyOn or l.on) and fdist(l.pos, pos) <= radius then out[#out + 1] = l end
	end
	return out
end

function Lamps:Update(dt)
	local pf = Player:Floor()
	if pf ~= self.lastFloor then
		self.lastFloor = pf
		Env:Boost(pf == -1 or pf == 2)
	end
	local t = os.clock()
	for i, l in ipairs(self.list) do
		local vis = (l.floor == pf) or (l.atrium and math.abs(l.floor - pf) == 1)
		local want = l.on and vis
		if l.light.Enabled ~= want then l.light.Enabled = want end
		if want and Monster.state ~= "Dormant" and Monster.fade > 0.2 and fdist(l.pos, Monster.pos) < 30 and rng:NextNumber() < 0.3 then
			l.light.Brightness = rand(0, (l.base or 2) * 0.5)
		elseif want and not l.busy then
			if S.power then
				l.light.Brightness = (l.base or 2) + math.sin(t * 3 + i) * 0.7
			elseif l.unstable and rng:NextNumber() < 0.05 then
				l.light.Brightness = rand(0.3, l.base or 2.6)
			else
				l.light.Brightness = lerp(l.light.Brightness, l.base or 2.6, 0.2)
			end
		end
	end
end

