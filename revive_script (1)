function Monster:DistToPlayer()
	local pp = Player:Pos()
	if not pp or self.state == "Dormant" then return math.huge end
	return fdist(pp, self.pos)
end

function Monster:Face(v)
	local f = V(v.X, 0, v.Z)
	if f.Magnitude > 0.01 then self.faceDir = f.Unit end
end

function Monster:Burst() if self.burst then self.burst:Emit(24) end end

function Monster:InView(pp)
	local cam = Cam()
	local to = (self.pos + V(0, 5, 0)) - cam.CFrame.Position
	if to.Magnitude < 1 then return true end
	if cam.CFrame.LookVector:Dot(to.Unit) < 0.8 then return false end
	return World:LOS(cam.CFrame.Position, self.pos + V(0, 5, 0))
end

function Monster:CanSense(pp, hunting)
	if S.hidden then return false end
	local d = fdist(pp, self.pos)
	local range = S.power and (S.hasCard and 22 or 18) or 12
	if S.flashOn then range = math.max(range, 36) end
	if hunting then range = math.max(range, 34) end
	if d > range then return false end
	return World:LOS(self.pos + V(0, 3.5, 0), V(pp.X, pp.Y, pp.Z))
end

function Monster:HuntSpeed()
	local i = S.hasCutters and 5 or (S.hasCode and 4 or (S.hasCard and 3 or (S.power and 2 or 1)))
	return CONFIG.HuntSpeed[i]
end

function Monster:SetState(s)
	self.state = s
	self.stateT, self.path, self.pathIdx = 0, nil, 1
	self.relocated, self.exposeT, self.seenT, self.spotT, self.waitT = false, 0, 0, 0, 0
	self.searchRoute = nil
	if s ~= "Special" then self.script = nil end
	local g = (s == "Hunting" or s == "Attacking") and 0 or ((s == "Investigating" or s == "Searching") and 0.5 or 0.85)
	for _, e in ipairs(self.glow) do e.base = g end
	self.leanTarget = (s == "Hunting" or s == "Attacking") and 0.5 or ((s == "Investigating" or s == "Searching") and 0.2 or 0.06)
	self.appliedFade = -1
	if s == "Dormant" then self.fadeTarget = 0 end
end

function Monster:Vanish(wait)
	self:Burst()
	self:SetState("Retreating")
	self.retreatWait = wait or (rand(8, 18) * math.max(0.65, 1 - S.phase * 0.07))
end

function Monster:Relocate(pp)
	if self.baseState == "Dormant" then self.pos = Nav.nodes["S4b"].pos return end
	local best, bs
	for _, n in pairs(Nav.nodes) do
		local d = fdist(n.pos, pp)
		local los = World:LOS(n.pos + V(0, 4, 0), V(pp.X, pp.Y, pp.Z))
		local sc = (d >= 45 and d <= 140) and 2 or (d >= 25 and 1 or 0)
		if not los then sc = sc + 1 end
		sc = sc + rand(0, 0.8)
		if not bs or sc > bs then best, bs = n, sc end
	end
	if best then self.pos = best.pos end
end

function Monster:BeginWatch(dur)
	local pp = Player:Pos()
	if not pp then return false end
	local c = {}
	for _, n in pairs(Nav.nodes) do
		local d = fdist(n.pos, pp)
		if d >= 30 and d <= 110 and World:LOS(n.pos + V(0, 4, 0), V(pp.X, pp.Y, pp.Z)) then c[#c + 1] = n end
	end
	if #c == 0 then return false end
	self:SetState("Watching")
	self.pos = pick(c).pos
	self.watchDur = dur or rand(5, 9)
	self.fade, self.fadeTarget = 0, 1
	self:Face(pp - self.pos)
	self.yaw = math.atan2(-self.faceDir.X, -self.faceDir.Z)
	self:Burst()
	Fear:Bump(0.2)
	Audio:Play("monster_breath", { pos = self.pos + V(0, 6, 0), volume = 0.4, max = 120 })
	return true
end

function Monster:StartHunt()
	if self.state == "Hunting" or self.state == "Attacking" or S.ending then return end
	local pp = Player:Pos()
	self:SetState("Hunting")
	self.pressure = 0
	self.lastSeen, self.lostT = pp and ground(pp) or self.pos, 0
	self.fadeTarget = 1
	self.fade = math.max(self.fade, 0.5)
	self:Burst()
	VFX:Shockwave(self.pos + V(0, 3, 0))
	Audio:Play("scream", { pos = self.pos + V(0, 6, 0), volume = 0.9, max = 200, priority = true })
	UI:Glitch(0.5)
	VFX:Shake(0.12, 0.6)
	Fear:Bump(0.5)
	UI:Caption("[he found you]")
end

function Monster:RepelFromBreath()
	local pp = Player:Pos()
	if not pp or self.state == "Dormant" or self.state == "Special" or self.state == "Attacking" then return end
	local delta = self.pos - pp
	local d = delta.Magnitude
	if d > 34 or d < 0.01 then return end
	local away = Vector3.new(delta.X, 0, delta.Z)
	if away.Magnitude < 0.01 then away = V(1, 0, 0) end
	local target = ground(pp + away.Unit * math.max(34, d + 8))
	self.pos = target
	self.investigatePos = nil
	if self.state == "Investigating" or self.state == "Searching" then self:SetState("Stalking") end
	Fear:Bump(0.05)
end

function Monster:Hear(pos, loud)
	if S.phase < 1 or S.ending then return end
	local st = self.state
	if st == "Hunting" or st == "Attacking" or st == "Special" or st == "Dormant" then return end
	local d = fdist(pos, self.pos)
	local radius = loud * 60
	if not World:LOS(self.pos + V(0, 3.5, 0), V(pos.X, pos.Y, pos.Z)) then radius = radius * 0.65 end
	if d > radius then return end
	if loud >= 0.85 and d < radius * 0.7 then
		self:StartHunt()
		return
	end
	self.investigatePos = ground(pos)
	if st ~= "Investigating" then
		self:SetState("Investigating")
		Audio:Play("growl", { pos = self.pos + V(0, 6, 0), volume = 0.4, cooldown = 6, max = 150 })
	end
	self.waitT = 0
end

function Monster:OnPlayerHide(lk)
	local seen = false
	if self.state == "Hunting" and lk then
		seen = self:DistToPlayer() < 20 and World:LOS(self.pos + V(0, 3.5, 0), lk.pos + V(0, 2, 0))
	end
	S.hiddenSeen = seen
	self.suspect = seen
end

function Monster:LostPos(lk)
	local base = lk and lk.pos or self.pos
	local c = {}
	for _, n in pairs(Nav.nodes) do
		local d = fdist(n.pos, base)
		if d > 14 and d < 38 then c[#c + 1] = n.pos end
	end
	if #c > 0 then return pick(c) end
	return ground(base)
end

function Monster:ScriptedRun(points, speed, cb)
	self:SetState("Special")
	self.pos = points[1]
	self.path, self.pathIdx = points, 2
	self.script = { speed = speed, done = cb }
	self.fade, self.fadeTarget = 0.6, 1
	self:Burst()
end

function Monster:Plan(target)
	local from, to = self.pos + V(0, 3.5, 0), V(target.X, target.Y + 2.5, target.Z)
	if flY(self.pos.Y) == flY(target.Y) and World:LOS(from, to) then
		self.path = { target }
	else
		local ids = Nav:Path(Nav:Nearest(self.pos, true), Nav:Nearest(target, true))
		local path = {}
		for _, id in ipairs(ids) do path[#path + 1] = Nav.nodes[id].pos end
		path[#path + 1] = target
		self.path = path
	end
	self.pathIdx = 1
end

function Monster:Follow(speed, dt)
	local path = self.path
	if not path or self.pathIdx > #path then self.curSpeed = 0 return true end
	local tgt = path[self.pathIdx]
	local dx, dz = tgt.X - self.pos.X, tgt.Z - self.pos.Z
	local dy = tgt.Y - self.pos.Y
	local m = math.sqrt(dx * dx + dz * dz)
	if m < 0.8 then
		self.pos = V(self.pos.X, tgt.Y, self.pos.Z)
		self.pathIdx = self.pathIdx + 1
		if self.pathIdx > #path then self.curSpeed = 0 return true end
		return false
	end
	local dir = V(dx / m, 0, dz / m)
	local step = math.min(speed * dt, m)
	self.pos = self.pos + dir * step + V(0, dy * (step / m), 0)
	self.faceDir = dir
	self.curSpeed = speed
	return false
end

function Monster:PathTo(target, dt, speed, stopDist)
	if stopDist and fdist(target, self.pos) <= stopDist then self.curSpeed = 0 return true end
	self.repathT = self.repathT - dt
	if not self.path or self.repathT <= 0 then
		self.repathT = 0.5
		self:Plan(ground(target))
	end
	return self:Follow(speed, dt)
end

function Monster:HandleDoors()
	if self.curSpeed < 1 then return end
	for _, d in ipairs(World.DoorList) do
		if not d.open and fdist(d.pos, self.pos) < 6.5 then Doors:Set(d, true, "monster") end
	end
end

local ST = {}

ST.Dormant = function(self) self.fadeTarget = 0 self.curSpeed = 0 end

ST.Watching = function(self, dt, pp)
	self.fadeTarget, self.curSpeed = 1, 0
	self:Face(pp - self.pos)
	if self:InView(pp) then self.seenT = self.seenT + dt else self.seenT = math.max(0, self.seenT - dt * 0.5) end
	if self.seenT > 1.4 or self.stateT > self.watchDur or fdist(pp, self.pos) < 16 then
		self:Vanish(rand(10, 22) * math.max(0.65, 1 - S.phase * 0.07))
	end
end

ST.Retreating = function(self, dt, pp)
	self.fadeTarget, self.curSpeed = 0, 0
	if not self.relocated and self.fade < 0.04 then
		self:Relocate(pp)
		self.relocated, self.waitT = true, self.retreatWait
	end
	if self.relocated then
		self.waitT = self.waitT - dt
		if self.waitT <= 0 then
			if self.baseState == "Stalking" and rng:NextNumber() < 0.35 and self:BeginWatch(rand(4, 8)) then return end
			self:SetState(self.baseState)
		end
	end
end

local function huntAfter()
	local ph = S.phase
	return (ph >= 4 and 35) or (ph >= 3 and 55) or (ph >= 2 and 85) or 130
end

ST.Stalking = function(self, dt, pp)
	local d = fdist(pp, self.pos)
	if d < 48 and self.stateT > 2 and self:InView(pp) then
		self.fadeTarget, self.curSpeed = 1, 0
		self.exposeT = self.exposeT + dt
		self:Face(pp - self.pos)
		if self.exposeT > 0.9 then Fear:Bump(0.35) self:Vanish(rand(6, 12) * math.max(0.65, 1 - S.phase * 0.07)) end
		return
	end
	self.exposeT, self.fadeTarget = 0, 0
	self.senseT = self.senseT - dt
	if self.senseT <= 0 then
		self.senseT = 0.25
		if S.phase >= 1 and self:CanSense(pp) then self:StartHunt() return end
	end
	local ph = S.phase
	local stop = (ph >= 4 and 12) or (ph >= 3 and 16) or (ph >= 2 and 24) or 34
	local spd = (ph >= 3) and 8 or 7
	self:PathTo(pp, dt, spd, stop)
	if self.pressure > huntAfter() then self:StartHunt() end
end

ST.Investigating = function(self, dt, pp)
	self.fadeTarget = 1
	self.senseT = self.senseT - dt
	if self.senseT <= 0 then
		self.senseT = 0.2
		if self:CanSense(pp) then self:StartHunt() return end
	end
	if self:PathTo(self.investigatePos or self.pos, dt, 9.5, 1.2) then
		self.curSpeed = 0
		self.waitT = self.waitT + dt
		if self.waitT > 4 then
			self.searchPos = self.investigatePos
			self:SetState("Searching")
		end
	end
end

ST.Hunting = function(self, dt, pp)
	self.fadeTarget = 1
	if S.hidden then
		local lk = S.hideSpot
		if S.hiddenSeen and lk then
			local front = ground(lk.pos + lk.cf.LookVector * 3)
			if self:PathTo(front, dt, self:HuntSpeed(), 1.5) then
				self.searchPos = front
				self:SetState("Searching")
				self.suspect = true
			end
		else
			self.searchPos = self:LostPos(lk)
			self:SetState("Searching")
		end
		return
	end
	self.senseT = self.senseT - dt
	if self.senseT <= 0 then
		self.senseT = 0.15
		if self:CanSense(pp, true) then self.lastSeen, self.lostT = ground(pp), 0 else self.lostT = self.lostT + 0.15 end
	end
	local tracking = self.stateT < (S.phase >= 3 and 5 or 3)
	if tracking then self.lastSeen = ground(pp) end
	if self.lostT > 3.5 and not tracking then
		self.searchPos = self.lastSeen
		self:SetState("Searching")
		return
	end
	if fdist(pp, self.pos) < 3.0 and (self.lostT < 0.5 or tracking) then self:Catch("grab") return end
	local target = (self.lostT < 0.5 or tracking) and ground(pp) or (self.lastSeen or ground(pp))
	self:PathTo(target, dt, self:HuntSpeed(), 0.5)
	if self.lostT >= 0.5 and not tracking and fdist(target, self.pos) < 1.5 then self.lostT = self.lostT + dt * 2 end
end

ST.Searching = function(self, dt, pp)
	self.fadeTarget = 1
	self.senseT = self.senseT - dt
	if self.senseT <= 0 then
		self.senseT = 0.2
		if self:CanSense(pp) then self:StartHunt() return end
	end
	if S.hidden and S.hideSpot then
		if fdist(S.hideSpot.pos, self.pos) < 4.5 then
			local rate = S.holdBreath and (self.suspect and 0.15 or 0.25) or (self.suspect and 1.2 or 1)
			self.spotT = self.spotT + dt * rate
			if self.spotT > (self.suspect and 8 or 10) then self:Catch("locker") return end
		else
			self.spotT = math.max(0, self.spotT - dt * 0.5)
		end
	end
	if not self.searchRoute then
		local route = { { pos = self.searchPos or self.pos } }
		local near = {}
		for _, n in pairs(Nav.nodes) do
			if fdist(n.pos, route[1].pos) < 60 then near[#near + 1] = n.pos end
		end
		for _ = 1, 4 do if #near > 0 then route[#route + 1] = { pos = pick(near) } end end
		if S.phase >= 3 and not self.suspect and rng:NextNumber() < 0.45 then
			local cands = {}
			for _, lk in ipairs(World.Lockers) do
				if fdist(lk.pos, route[1].pos) < 45 then cands[#cands + 1] = lk end
			end
			for _ = 1, math.min(2, #cands) do
				local lk = table.remove(cands, randi(1, #cands))
				route[#route + 1] = { pos = ground(lk.pos + lk.cf.LookVector * 3), lk = lk }
			end
		end
		self.searchRoute, self.searchIdx, self.pauseT = route, 1, 0
	end
	if self.pauseT > 0 then
		self.pauseT, self.curSpeed = self.pauseT - dt, 0
		if self.pauseT <= 0 and self.inspecting then
			local lk = self.inspecting
			self.inspecting = nil
			if S.hidden and S.hideSpot == lk then
				if not (S.holdBreath and rng:NextNumber() < 0.5) then self:Catch("locker") return end
			end
		end
		return
	end
	local entry = self.searchRoute[self.searchIdx]
	if not entry or self.stateT > 34 then self:Vanish(rand(8, 16) * math.max(0.65, 1 - S.phase * 0.07)) return end
	if self:PathTo(entry.pos, dt, 8, 1.2) then
		self.searchIdx, self.path = self.searchIdx + 1, nil
		if entry.lk then
			self.pauseT, self.inspecting = 2.4, entry.lk
			Audio:Play("locker", { pos = entry.lk.pos, volume = 0.6 })
		else
			self.pauseT = rand(1.2, 2.6)
		end
	end
end

ST.Special = function(self, dt)
	self.fadeTarget = 1
	if self.script then
		if self:Follow(self.script.speed, dt) then
			local cb = self.script.done
			self.script = nil
			if cb then cb() else self:Vanish(rand(10, 20)) end
		end
	else
		self.curSpeed = 0
	end
end

ST.Attacking = function(self) self.curSpeed = 0 end

function Monster:Catch(kind)
	self:SetState("Attacking")
	Game:Caught(kind)
end

function Monster:Watchdog(dt)
	local st = self.state
	if self.baseState ~= "Dormant" and (st == "Stalking" or st == "Retreating" or st == "Watching") then
		self.pressure = self.pressure + dt
	end
	if st == "Dormant" and self.baseState ~= "Dormant" then
		self:SetState(self.baseState)
	elseif (st == "Retreating" and self.stateT > 45) or (st == "Watching" and self.stateT > 30)
		or (st == "Investigating" and self.stateT > 40) or (st == "Searching" and self.stateT > 50)
		or (st == "Special" and self.stateT > 25) then
		self:SetState(self.baseState)
	end
end

function Monster:Update(dt)
	if not self.root or not self.root.Parent then return end
	self.animT = self.animT + dt
	self.stateT = self.stateT + dt
	local pp = Player:Pos()
	if pp and not S.reading and not S.ending and S.phase >= 1 then
		self:Watchdog(dt)
		local fn = ST[self.state]
		if fn then fn(self, dt, pp) end
		self:HandleDoors()
	elseif S.ending then
		self.curSpeed = 0
	else
		self.curSpeed = 0
	end
	self:Apply(dt)
	self:Animate(dt)
	local eyeOn = false
	if pp and S.phase >= 1 and self.baseState ~= "Dormant" and self.state ~= "Retreating" and self.state ~= "Dormant" and not S.ending then
		eyeOn = fdist(pp, self.pos) < 75 and World:LOS(self.pos + V(0, 5, 0), pp + V(0, 1, 0))
	end
	self.eyeTarget = eyeOn and 1 or 0
	self:FadeStep(dt)
	if not S.reading then self:Sounds(dt, pp) end
end

function Monster:Apply(dt)
	local want = math.atan2(-self.faceDir.X, -self.faceDir.Z)
	local rate = (self.state == "Hunting" or self.state == "Attacking") and 9 or 3.5
	if dt <= 0 then self.yaw = want else self.yaw = self.yaw + clamp(wrapAngle(want - self.yaw), -rate * dt, rate * dt) end
	self.kneel = lerp(self.kneel, self.kneeling and 1 or 0, clamp(dt * 1.5, 0, 1))
	self.root.CFrame = CFrame.new(self.pos.X, self.pos.Y + HOVER - self.kneel * 2.4, self.pos.Z) * CFrame.Angles(0, self.yaw, 0)
end

local function rot(b, x, y, z) if b then b.m.C0 = b.c0 * CFrame.Angles(x or 0, y or 0, z or 0) end end

function Monster:Animate(dt)
	local B = self.bones
	if not B.Head then return end
	local st = self.state
	local hunting = st == "Hunting" or st == "Attacking"
	local t = self.animT
	self.lean = lerp(self.lean, self.leanTarget + self.kneel * 0.5, clamp(dt * 3, 0, 1))
	self.walkPhase = self.walkPhase + dt * (2.2 + self.curSpeed * 0.75)
	local mv = clamp(self.curSpeed / 6, 0, 1)
	local sw = math.sin(self.walkPhase) * mv
	local k = self.kneel
	rot(B.THL, sw * 0.65 + k * 1.3) rot(B.THR, -sw * 0.65 + k * 1.3)
	rot(B.SHL, -math.max(0, sw) * 0.8 - k * 2) rot(B.SHR, -math.max(0, -sw) * 0.8 - k * 2)
	local armUp = (st == "Attacking") and 1.3 or (hunting and 0.8 or 0)
	local idle = math.sin(t * 0.9) * 0.05
	rot(B.UAL, armUp - sw * 0.35 + idle) rot(B.UAR, armUp + sw * 0.35 - idle)
	local el = (st == "Attacking") and 0.2 or (hunting and 0.6 or 0.06)
	rot(B.FAL, el + math.sin(t * 3) * 0.04) rot(B.FAR, el + math.cos(t * 3) * 0.04)
	for i, f in ipairs(self.fingers) do rot(f, 0.15 + math.sin(t * 2.4 + i) * 0.15 + (hunting and 0.4 or 0)) end
	rot(B.Torso, -self.lean * 0.6)
	rot(B.Chest, -self.lean * 0.5, math.sin(t * 0.7) * 0.05)
	self.twT = self.twT - dt
	if self.twT <= 0 then
		self.twT = hunting and rand(0.4, 1.4) or rand(1.5, 5)
		self.twTarget = V(rand(-0.35, 0.35), rand(-0.9, 0.9), rand(-0.3, 0.3))
	end
	self.tw = self.tw:Lerp(self.twTarget, clamp(dt * (hunting and 18 or 7), 0, 1))
	rot(B.Head, self.tw.X - self.lean * 0.2, self.tw.Y, 0.32 + self.tw.Z)
	rot(B.Neck, -self.lean * 0.3 + 0.15)
	rot(B.Tail, -(0.12 + mv * 0.45) + math.sin(t * 1.3) * 0.05)
	for i, r in ipairs(self.rags or {}) do rot(r, -(0.1 + mv * 0.6) + math.sin(t * 2 + i) * 0.08, 0, math.sin(t * 1.5 + i * 2) * 0.1) end
end

function Monster:FadeStep(dt)
	local rate = (self.state == "Hunting") and 4 or 1.6
	if self.fade < self.fadeTarget then self.fade = math.min(self.fadeTarget, self.fade + dt * rate)
	else self.fade = math.max(self.fadeTarget, self.fade - dt * rate) end
	if math.abs(self.fade - self.appliedFade) > 0.01 or self.appliedFade < 0 then
		self.appliedFade = self.fade
		for _, e in ipairs(self.partList) do e.p.Transparency = 1 - self.fade * (1 - e.base) end
	end
	self.eye = lerp(self.eye or 0, self.eyeTarget or 0, clamp(dt * 3, 0, 1))
	for _, e in ipairs(self.glow) do
		local base = 1 - self.fade * (1 - e.base)
		e.p.Transparency = math.min(base, 1 - self.eye * 0.95)
	end
	if self.aura then self.aura.Enabled = self.fade > 0.25 end
	if self.light then
		local hunting = self.state == "Hunting" or self.state == "Attacking"
		self.light.Brightness = math.max((hunting and 1.4 or 0.2) * self.fade, (self.eye or 0) * 0.5)
	end
end

function Monster:Sounds(dt, pp)
	if not pp then return end
	local d = fdist(pp, self.pos)
	if self.curSpeed > 0.5 then
		self.stepT = self.stepT - dt
		if self.stepT <= 0 then
			self.stepT = clamp(2.4 / (self.curSpeed * 0.45 + 1), 0.3, 1.1)
			if d < 90 then
				Audio:Play(d > 26 and "footstep_far" or "footstep_near", { pos = self.pos + V(0, 0.5, 0),
					volume = clamp(1.1 - d / 90, 0.12, 0.9), min = 6, max = 110, pitch = 0.75, cooldown = 0.12 })
			end
		end
	end
	self.growlT = (self.growlT or 3) - dt
	if self.growlT <= 0 then
		self.growlT = rand(3, 6)
		if (self.state == "Hunting" or self.state == "Searching") and d < 70 then
			Audio:Play("growl", { pos = self.pos + V(0, 6, 0), volume = 0.7, max = 130, cooldown = 2 })
		end
	end
	self.breathT = self.breathT - dt
	if self.breathT <= 0 then
		self.breathT = rand(5, 10)
		if d < 30 and self.state ~= "Dormant" then
			Audio:Play("monster_breath", { pos = self.pos + V(0, 6, 0), volume = 0.5, max = 60 })
		end
	end
end

