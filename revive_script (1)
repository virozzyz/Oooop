function Game:Caught(kind)
	if S.ending then return end
	S.ending, S.cinematic = "dead", true
	S.reviveCFrame = Char.Root and Char.Root.CFrame or nil
	local id = S.runId
	task.spawn(function()
		local cam, root = Cam(), Char.Root
		S.camLock = true
		cam.CameraType = Enum.CameraType.Scriptable
		if root then root.Anchored = true end
		local m = Monster
		if kind == "locker" and S.hideSpot then
			local lk = S.hideSpot
			tween(lk.front, 0.15, { CFrame = lk.front.CFrame * CFrame.new(LW, 0, 0) })
			Audio:Play("door_slam", { pos = lk.pos, priority = true })
			m.pos = ground(lk.pos + lk.cf.LookVector * 3)
			m.faceDir = -lk.cf.LookVector
			m.fade, m.fadeTarget = 1, 1
		end
		Audio:Play("scream", { volume = 1, priority = true, caption = "[scream]" })
		local start = cam.CFrame
		local head = m.pos + V(0, 9.2, 0)
		local goal = CFrame.lookAt(head + m.faceDir * 2.6 + V(0, -0.3, 0), head)
		local t0 = os.clock()
		while os.clock() - t0 < 0.5 and (S.alive and S.runId == id) do
			local a = (os.clock() - t0) / 0.5
			cam.CFrame = start:Lerp(goal, a * a) * CFrame.new(rand(-0.05, 0.05) * a, rand(-0.05, 0.05) * a, 0)
			cam.FieldOfView = lerp(70, 42, a)
			RunService.RenderStepped:Wait()
		end
		if S.runId ~= id or not S.alive then return end
		UI:FaceFlash(0.18)
		UI:FadeColor(Color3.new(0, 0, 0))
		UI:Fade(1, 0.05)
		Audio:Play("jumpscare", { volume = 1, priority = true, caption = false })
		task.wait(1.2)
		if S.runId ~= id or not S.alive then return end
		Audio:Play("fail", { caption = false })
		UI:ShowEnd("THE SILENCE FOUND YOU", pick({ "He did not see you. He heard you.", "Nobody screamed. Nobody heard.", "The Night Shifter never misses a sound.", "End of shift.", "Day 31. Again.", "Elena is still screaming." }) .. "\n\nYour inventory and quest progress will be kept.", COL.red2)
		UI:SetReviveVisible(true)
	end)
end

function Game:Revive()
	if not S.running or S.ending ~= "dead" then return end
	local reviveCF = S.reviveCFrame
	S.ending, S.cinematic, S.camLock, S.paused = nil, false, false, false
	S.hidden, S.hideSpot, S.hiddenSeen, S.holdBreath, S.breathHeld, S.breathAwayT = false, nil, false, false, false, 0
	UI:SetReviveVisible(false)
	UI:HideEnd()
	UI:FadeColor(Color3.new(0, 0, 0))
	UI:Fade(0, 0.45)
	-- A cutscene leaves the camera Scriptable; restore the normal player camera before anticheat checks resume.
	local cam = Cam()
	local root, hum = Char.Root, Char.Hum
	if cam then
		cam.CameraType = Enum.CameraType.Custom
		cam.FieldOfView = 70
	end
	if hum and hum.Parent and cam then cam.CameraSubject = hum end
	pcall(function() LP.CameraMode = Enum.CameraMode.LockFirstPerson end)
	-- Ignore the intentional respawn reposition/camera handoff for a short, bounded window.
	Anticheat:Reset(5)
	Anticheat.grace = math.max(Anticheat.grace or 0, 5)
	if root and root.Parent then
		if reviveCF then root.CFrame = reviveCF end
		root.Anchored = false
	end
	if hum and hum.Parent then
		pcall(function()
			hum.Health = hum.MaxHealth
			hum:ChangeState(Enum.HumanoidStateType.GettingUp)
		end)
	end
	Inv:Rebuild()
	Inv:Refresh()
	-- Put Elena at the farthest navigation node so the revive cannot immediately retrigger death.
	local farPos, farDist = nil, -math.huge
	if root and root.Parent then
		for _, node in pairs(Nav.nodes) do
			local d = fdist(node.pos, root.Position)
			if d > farDist then farPos, farDist = node.pos, d end
		end
	end
	if farPos then
		Monster.pos = farPos
		Monster.fade, Monster.fadeTarget = 0, 0
		Monster.pressure, Monster.senseT, Monster.exposeT = 0, 0.8, 0
		Monster:SetState("Stalking")
	else
		Monster:SetState("Retreating")
		Monster.retreatWait = 10
	end
	Audio:Duck(0.35)
	UI:Toast("Revived. Inventory and quest progress restored.")
	UI:Hint("Keep moving. He is still listening.", 3.5)
	S.reviveCFrame = nil
end

function Game:ResetState()
	S.running, S.paused, S.reading, S.cinematic, S.ending = false, false, false, false, nil
	S.phase, S.fusesPicked, S.fusesHeld, S.fusesIn, S.pages, S.hasCard, S.hasKey, S.hasCode, S.hasCutters, S.power = 0, 0, 0, 0, 0, false, false, false, false, false
	S.battery, S.stamina, S.winded, S.flashOn, S.sprintHeld, S.sprinting = 100, 100, false, false, false, false
	S.noise, S.hidden, S.hideSpot, S.hiddenSeen, S.holdBreath, S.breathHeld, S.breathAwayT, S.fear, S.camLock, S.calm = 0, false, nil, false, false, false, 0, 0, false, false
	S.perk = false
	S.hasWeapon, S.weaponShots, S.elenaDead = false, 0, false
	S.reviveCFrame = nil
	Director.timer, Director.lastAt, Director.lastId = 25, {}, nil
	Fear.bump, Fear.hbT, Fear.breathT = 0, 0, 0
