function UI:Whisper(text) fadeText(self.el.say, "say", text, 3.2, Color3.fromRGB(150, 150, 160)) end
function UI:Toast(text) fadeText(self.el.toast, "toast", text, 2.6, COL.txt) end
function UI:Hint(text, dur) fadeText(self.el.hint, "hint", text, dur or 4, COL.dim) end
function UI:Caption(text)
	local now = os.clock()
	if (self.lastCap.text == text and now - self.lastCap.t < 2.5) or now - self.lastCap.t < 0.8 then return end
	self.lastCap.text, self.lastCap.t = text, now
	fadeText(self.el.cap, "cap", text, 1.6, COL.dim)
end

