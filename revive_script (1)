function World:BuildItems()
	for _, src in ipairs(ITEMS) do
		local it = {}
		for k, v in pairs(src) do it[k] = v end
		local room = self.RoomById[it.room]
		if room then
			FY = room.fy
			local x, z = room.cx + it.dx, room.side * (ROOMC + it.dz)
			local k, p = it.kind, nil
			if k == "computer" then
				p = self:BuildTerminal(it, room, x, z)
			else
				local base = C(x, it.y + (ITEM_LIFT[k] or 0.1), z) * CFrame.Angles(0, rand(0, 6.28), 0)
				local handle, model = Kit.realize(Kit.SPECS[k](), self.Decor, base, "world")
				N("PointLight", { Range = 5, Brightness = 0.4, Color = (k == "fuse" and Color3.fromRGB(255, 170, 60)) or (k == "battery" and Color3.fromRGB(70, 215, 105))
					or (k == "key" and Color3.fromRGB(215, 170, 70)) or (k == "code" and Color3.fromRGB(190, 90, 255))
					or (k == "cutters" and Color3.fromRGB(255, 120, 40)) or Color3.fromRGB(150, 160, 200) }, handle)
				it.model, it.base, it.phase = model, base, rand(0, 6.28)
				p = handle
			end
			it.part = p
			local t = ITEM_TEXT[k]
			it.prompt = self:Prompt(p, t[1], t[2], function() Story:Collect(it) end, { dist = 7.5, hold = (k == "fuse") and 1 or 0 })
			self.Items[#self.Items + 1] = it
		end
	end
		if UGC:WeaponUnlocked() then
			local room = (#self.RoomList > 0) and pick(self.RoomList) or nil
			if room then
				local it = { id = "elenaWeapon", kind = "weapon", room = room.id, dx = 0, dz = 0, y = 1.15, phase = rand(0, 6.28) }
				local x, z = room.cx + it.dx, room.side * (ROOMC + it.dz)
				local base = C(x, it.y + ITEM_LIFT.weapon, z) * CFrame.Angles(0, rand(0, 6.28), 0)
				local handle, model = Kit.realize(Kit.SPECS.weapon(), self.Decor, base, "world")
				N("PointLight", { Range = 12, Brightness = 2.2, Color = Color3.fromRGB(220, 40, 30) }, handle)
				it.model, it.base, it.part = model, base, handle
				it.prompt = self:Prompt(handle, "Old revolver", "Take", function() Story:Collect(it) end, { dist = 7.5 })
				self.Items[#self.Items + 1] = it
			end
		end
		FY = 0
	end

function World:AnimateItems(dt)
	local pp = Player:Pos()
	if not pp then return end
	local t = os.clock()
	for _, it in ipairs(self.Items) do
		local m = it.model
		if m and m.Parent and it.base and fdist(it.base.Position, pp) < 45 then
			m:PivotTo(it.base * CFrame.new(0, 0.15 + math.sin(t * 1.6 + it.phase) * 0.1, 0) * CFrame.Angles(0, math.sin(t * 0.8 + it.phase) * 0.14, 0))
		end
	end
end

