function Game:BindInputs()
	local CAS = ContextActionService
	CAS:BindAction(CONFIG.Act.Flash, function(_, st)
		if st == Enum.UserInputState.Begin then Player:ToggleFlash() end
		return Enum.ContextActionResult.Sink
	end, false, Enum.KeyCode.F, Enum.KeyCode.ButtonY)
	CAS:BindAction(CONFIG.Act.Sprint, function(_, st)
		if st == Enum.UserInputState.Begin then S.sprintHeld = true elseif st == Enum.UserInputState.End then S.sprintHeld = false end
		return Enum.ContextActionResult.Sink
	end, false, Enum.KeyCode.LeftShift, Enum.KeyCode.ButtonL3)
	CAS:BindAction(CONFIG.Act.Breath, function(_, st)
			if st == Enum.UserInputState.Begin then S.breathHeld = true elseif st == Enum.UserInputState.End or st == Enum.UserInputState.Cancel then S.breathHeld = false end
			return Enum.ContextActionResult.Sink
		end, false, Enum.KeyCode.B)
		CAS:BindAction(CONFIG.Act.Pause, function(_, st)
		if st == Enum.UserInputState.Begin then Game:SetPaused(not S.paused) end
		return Enum.ContextActionResult.Pass
	end, false, Enum.KeyCode.P)
	CAS:BindAction(CONFIG.Act.Inv, function(_, st, input)
		if st ~= Enum.UserInputState.Begin then return Enum.ContextActionResult.Pass end
		local idx = Inv.KEYS[input.KeyCode]
		if idx and Inv.order[idx] then
			Inv:Toggle(Inv.order[idx])
			return Enum.ContextActionResult.Sink
		end
		return Enum.ContextActionResult.Pass
	end, false, Enum.KeyCode.One, Enum.KeyCode.Two, Enum.KeyCode.Three, Enum.KeyCode.Four, Enum.KeyCode.Five,
		Enum.KeyCode.Six, Enum.KeyCode.Seven, Enum.KeyCode.Eight, Enum.KeyCode.Nine)
end
function Game:UnbindInputs()
	for _, n in ipairs({ CONFIG.Act.Flash, CONFIG.Act.Sprint, CONFIG.Act.Breath, CONFIG.Act.Pause, CONFIG.Act.Inv }) do pcall(function() ContextActionService:UnbindAction(n) end) end
end

function Game:Begin()
	if UGC.claimed then UI:ShowClaim() return end
	UI:ShowTitle(false)
	task.spawn(function() safe("iniciar", Game.StartRun, Game) end)
end

function Game:StartRun()
	if S.running then return end
	local t0 = os.clock()
	while (not Char.Root or not Char.Root.Parent or not Char.Hum) and os.clock() - t0 < 12 do task.wait(0.1) end
	if not Char.Root then UI:ShowTitle(true) UI:Toast("Character not found.") return end
	self:ResetState()
	S.runId = S.runId + 1
	local id = S.runId
	UI:ResetRun()
	UI:FadeColor(Color3.new(0, 0, 0))
	UI.el.fade.BackgroundTransparency = 0
	Char.Root.Anchored = true
	Env:Apply()
	World:Build()
	Nav:Build()
	Monster:Build()
	Player:Setup()
	Char.Root.Anchored = false
	Anticheat:Arm()
	Inv:Begin()
	UI:SetHUD(true)
	UI:SetObjective("Read the note in the Nurses' Station (first door on the right)")
	self:BindInputs()
	S.running, S.cinematic = true, true
	task.wait(0.4)
	UI:Say("03:12. Saint Helen Hospital.", 3)
	task.wait(2.6)
	if not isRun(id) then return end
	UI:Say("You wake up in the hallway. You cannot remember your name.", 3.5)
	UI:Fade(0, 2.5)
	task.wait(1.5)
	if not isRun(id) then return end
	S.cinematic = false
	UI:Hint("Tip: he cannot see. Running and doors make noise. Press F for the flashlight.", 6)
		if UGC:WeaponUnlocked() then
			task.delay(2.5, function() if isRun(id) then UI:Say("You feel the urge to kill her", 4.5, COL.red2) UI:Toast("A weapon is waiting somewhere in the hospital.") end end)
		end
		UI:OfferPerk()
end

function Game:StopRun()
	local was = S.running or Player.saved ~= nil
	S.running = false
	S.runId = S.runId + 1
	self:UnbindInputs()
	if was then safe("restaurar", Player.Restore, Player) end
	RunMaid:Clean()
	Inv:End()
	Monster:Reset()
	Audio:StopAll()
	Env:Restore()
	UI:ResetRun()
	UI:SetHUD(false)
	self:ResetState()
end

function Game:Restart()
	self:StopRun()
	task.spawn(function() safe("reiniciar", Game.StartRun, Game) end)
end

function Game:Tick(dt)
	dt = math.min(dt, 0.1)
	safe("anticheat", Anticheat.Update, Anticheat, dt)
	safe("jogador", Player.Update, Player, dt)
	safe("missoes", Story.RefreshLocks, Story)
	safe("inv", Inv.Update, Inv, dt)
	safe("itens", World.AnimateItems, World, dt)
	safe("monstro", Monster.Update, Monster, dt)
	safe("diretor", Director.Update, Director, dt)
	safe("medo", Fear.Update, Fear, dt)
	safe("audio", Audio.Update, Audio, dt)
	safe("luzes", Lamps.Update, Lamps, dt)
	safe("quebra", Lamps.Tick, Lamps, dt)
end

function Game:Frame(dt)
	UI:Anim(dt)
	if S.running and not S.paused then self:Tick(dt) end
end

function Game:OnRespawn()
	if not S.running then return end
	S.hidden, S.hideSpot, S.holdBreath, S.breathHeld, S.breathAwayT = false, nil, false, false, 0
	local sv = Player.saved
	Player:Setup()
	if sv then Player.saved = sv end
	Anticheat:Arm()
	Inv:Rebuild()
end

local function bindCharacter(model)
	if not model then return end
	local hum = model:WaitForChild("Humanoid", 15)
	local root = model:WaitForChild("HumanoidRootPart", 15)
	if not hum or not root then return end
	Char.Model, Char.Hum, Char.Root = model, hum, root
	if S.running and S.alive then safe("respawn", Game.OnRespawn, Game) end
end

function Game:Destroy()
	if S.destroyed then return end
	S.destroyed, S.alive = true, false
	safe("parar", Game.StopRun, Game)
	pcall(function() RunService:UnbindFromRenderStep(Game.renderName) end)
	RootMaid:Clean()
	genv[GKEY] = nil
end

function Game:Init()
	UI:Build()
	Inv:BuildUI()
	UI:BuildPerk()
	UGC:Load()
	UI:BuildUGC()
	Audio:Init()
	RootMaid:Give(RunService.Heartbeat:Connect(function(dt) Game:Frame(dt) end))
	self.renderName = randName()
	RunService:BindToRenderStep(self.renderName, Enum.RenderPriority.Camera.Value + 1, function(dt)
		if S.running and not S.paused then safe("render", VFX.Render, VFX, dt) end
	end)
	RootMaid:Give(LP.CharacterAdded:Connect(function(m) task.spawn(bindCharacter, m) end))
	if LP.Character then task.spawn(bindCharacter, LP.Character) end
	local lastCmd = 0
	local function onChat(text)
		if type(text) ~= "string" then return end
		local t = (text:lower():gsub("^%s+", "")):gsub("%s+$", "")
		if t == "!g" and os.clock() - lastCmd > 0.5 then
			lastCmd = os.clock()
			Game:AdminWeapon()
		elseif t == "!p" and os.clock() - lastCmd > 0.5 then
			lastCmd = os.clock()
			Game:AdminPursuit()
		elseif t == "!u" and os.clock() - lastCmd > 0.5 then
			lastCmd = os.clock()
			Game:AdminNotes()
		elseif t == "!a" and os.clock() - lastCmd > 0.5 then
			lastCmd = os.clock()
			Game:AdminExit()
		end
	end
	RootMaid:Give(LP.Chatted:Connect(onChat))
	pcall(function()
		RootMaid:Give(TextChatService.MessageReceived:Connect(function(m)
			if m.TextSource and m.TextSource.UserId == LP.UserId then onChat(m.Text) end
		end))
	end)
	genv[GKEY] = { Destroy = function() Game:Destroy() end, Version = "11.0" }
	if UGC.claimed then UI:ShowClaim() else UI:ShowTitle(true) end
end

