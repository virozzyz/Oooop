function Player:ToggleFlash()
	if not S.running or S.paused or S.reading or S.ending then return end
	if S.battery <= 0 then
		Audio:Play("click", { caption = false })
		UI:Toast("No battery.")
		return
	end
	S.flashOn = not S.flashOn
	Audio:Play("click", { volume = 0.4, caption = false })
	if self.flash then self.flash.Enabled = S.flashOn end
end

function Player:UpdateFlash(cam)
	if not self.flashPart then return end
	self.flashPart.CFrame = cam.CFrame * CFrame.new(0.4, -0.35, -0.5)
	if self.dustPart then self.dustPart.CFrame = CFrame.new(cam.CFrame.Position + cam.CFrame.LookVector * 4) end
	if self.flash and S.flashOn then
		local near = Monster.state ~= "Dormant" and Monster.fade > 0.3 and fdist(Monster.pos, cam.CFrame.Position) < 26
		if (S.battery < 20 and rng:NextNumber() < 0.12) or (near and rng:NextNumber() < 0.07) then self.flash.Brightness = rand(0.2, 1.4)
		else self.flash.Brightness = lerp(self.flash.Brightness, 11, 0.2) end
	end
end

function Player:Update(dt)
	local hum, root = Char.Hum, Char.Root
	if not hum or not hum.Parent or not root or not root.Parent then return end
	local vel = root.AssemblyLinearVelocity
	local moving = (math.sqrt(vel.X * vel.X + vel.Z * vel.Z) > 2) and not S.hidden
	if S.winded and S.stamina > 25 then S.winded = false end
	local sprinting = S.sprintHeld and moving and not S.winded and S.stamina > 0 and not S.reading
	S.sprinting = sprinting
	if S.hidden then
		S.holdBreath = (S.sprintHeld or S.breathHeld) and S.stamina > 0 and not S.winded
		if S.holdBreath then S.stamina = math.max(0, S.stamina - 22 * dt) else S.stamina = math.min(100, S.stamina + 10 * dt) end
		if S.stamina <= 0 and not S.winded then
			S.winded = true
			Game:Noise(0.35, root.Position)
			Audio:Play("breath", { volume = 0.6 })
		end
	else
		S.holdBreath = S.breathHeld and not moving and S.stamina > 0 and not S.winded
		if S.holdBreath then
			S.stamina = math.max(0, S.stamina - 18 * dt)
		elseif sprinting then
			S.stamina = math.max(0, S.stamina - CONFIG.StaminaDrain * dt)
			if S.stamina <= 0 then S.winded = true end
		else
			S.stamina = math.min(100, S.stamina + CONFIG.StaminaRegen * dt)
		end
	end
	local wsGoal = (S.reading or S.hidden or S.ending) and 0 or (sprinting and (CONFIG.SprintSpeed + (S.perk and CONFIG.PerkSprint or 0)) or (S.winded and 8 or CONFIG.WalkSpeed))
	hum.WalkSpeed = wsGoal
	self.lastWS = wsGoal
	local nz = S.hidden and 0 or (sprinting and 0.55 or (moving and 0.12 or 0))
	S.noise = math.max(nz, S.noise - dt * 0.9)
		if S.holdBreath and not S.hidden and not moving then
			S.breathAwayT = math.max(0, (S.breathAwayT or 0) - dt)
			if S.breathAwayT <= 0 then
				S.breathAwayT = 0.55
				Monster:RepelFromBreath()
			end
		else
			S.breathAwayT = 0
		end
	self.hearT = (self.hearT or 0) - dt
	if self.hearT <= 0 then
		self.hearT = 0.3
		if S.noise >= 0.1 then Monster:Hear(root.Position, S.noise) end
	end
	if S.flashOn then
		S.battery = S.battery - dt * (100 / CONFIG.BatterySeconds) * (S.calm and 0.5 or 1) * ((Monster.fade > 0.3 and Monster:DistToPlayer() < 30) and 1.4 or 1)
		if S.battery <= 0 then
			S.battery, S.flashOn = 0, false
			if self.flash then self.flash.Enabled = false end
			Audio:Play("click", { caption = false })
			UI:Toast("The battery died.")
		end
	end
end

function Player:Hide(lk)
	if S.hidden or not Char.Root then return end
	if Monster.state == "Hunting" and Monster:DistToPlayer() < 10 then UI:Toast("Too close!") return end
	S.hidden, S.hideSpot = true, lk
	local root = Char.Root
	root.AssemblyLinearVelocity = Vector3.zero
	root.CFrame = lk.cf * CFrame.new(0, -1, 0)
	root.Anchored = true
	Anticheat:Reset(1)
	S.camLock = true
	Cam().CameraType = Enum.CameraType.Scriptable
	lk.front.Transparency = 0.55
	lk.prompt.ActionText = "Leave"
	Monster:OnPlayerHide(lk)
	Audio:Play("locker", { pos = lk.pos, volume = 0.5 })
	Game:Noise(0.08, lk.pos)
	Inv:Unequip()
	Inv:SetVisible(false)
	UI:Hint("Hold B / HOLD BREATH while standing still to push him away", 5)
end

function Player:Unhide()
	local lk = S.hideSpot
	if not lk then return end
	S.hidden, S.hideSpot, S.holdBreath, S.hiddenSeen = false, nil, false, false
	lk.front.Transparency = 0
	lk.prompt.ActionText = "Hide"
	local root = Char.Root
	if root then
		root.Anchored = false
		root.CFrame = lk.cf * CFrame.new(0, -1, -(LD / 2 + 2.2))
		Anticheat:Reset(1)
	end
	local cam = Cam()
	cam.CFrame = CFrame.lookAt(lk.cf.Position + V(0, 0.6, 0), lk.cf.Position + V(0, 0.6, 0) + lk.cf.LookVector)
	cam.CameraType = Enum.CameraType.Custom
	S.camLock = false
	Audio:Play("locker", { pos = lk.pos, volume = 0.4 })
	Inv:SetVisible(true)
end

VFX.shake = 0
function VFX:Shake(amp, dur) if not Opts.Reduce then self.shake = math.max(self.shake, amp) end end
function VFX:Shockwave(pos)
	if Opts.Reduce or not World.Folder then return end
	local s = N("Part", { Shape = Enum.PartType.Ball, Anchored = true, CanCollide = false, CanQuery = false, CanTouch = false,
		Material = Enum.Material.Neon, Color = Color3.fromRGB(200, 30, 30), Transparency = 0.5, Size = V(2, 2, 2), Position = pos }, World.Folder)
	tween(s, 0.7, { Size = V(70, 70, 70), Transparency = 1 })
	task.delay(0.8, function() pcall(function() s:Destroy() end) end)
end
function VFX:Pulse(f) self.pulse = (Opts.Reduce and 0.3 or 1) * (0.3 + f * 0.7) end

function VFX:Render(dt)
	local cam = Cam()
	if not cam then return end
	Player:UpdateFlash(cam)
	local t = os.clock()
	if S.hidden and S.hideSpot then
		local a = Opts.Reduce and 0 or (0.004 + S.fear * 0.012)
		cam.CFrame = S.hideSpot.cf * CFrame.new(0, 0.6, 0.35) * CFrame.Angles(math.noise(t * 3, 0.1) * a, math.noise(t * 3, 5.2) * a, 0)
		return
	end
	if S.camLock then return end
	local hum = Char.Hum
	local amp = 0
	if not Opts.Reduce then amp = 0.012 + S.fear * S.fear * 0.1 + self.shake + (S.sprinting and 0.02 or 0) end
	self.shake = math.max(0, self.shake - dt * 0.5)
	local vel = Char.Root and Char.Root.AssemblyLinearVelocity or Vector3.zero
	local spd = math.sqrt(vel.X * vel.X + vel.Z * vel.Z)
	local bob = (Opts.Reduce or spd < 2) and 0 or math.sin(t * (S.sprinting and 14 or 9)) * (S.sprinting and 0.16 or 0.09)
	if hum and hum.Parent then hum.CameraOffset = V(math.noise(t * 17, 1.3) * amp, math.noise(t * 17, 7.7) * amp + bob, 0) end
	local target = 70 + (S.sprinting and 6 or 0) + (Opts.Reduce and 0 or S.fear * 8)
	cam.FieldOfView = lerp(cam.FieldOfView, target, clamp(dt * 4, 0, 1))
end

Fear.bump, Fear.hbT, Fear.breathT = 0, 0, 0
function Fear:Bump(x) self.bump = math.max(self.bump, x) end

function Fear:HideBeat(dt)
	if not S.hidden then
		UI:HeartShow(false)
		self.hbPhase = 0
		return
	end
	local md, st = Monster:DistToPlayer(), Monster.state
	local near = 0
	if st ~= "Dormant" and md < 45 then
		near = clamp(1 - md / 45, 0, 1)
		if st == "Hunting" or st == "Searching" or st == "Investigating" or st == "Attacking" then near = math.min(1, near * 1.35) else near = near * 0.6 end
	end
	local bpm = 62 + near * 108
	if S.holdBreath then bpm = bpm * 0.78 end
	self.hbBpm = lerp(self.hbBpm or 62, bpm, clamp(dt * 2, 0, 1))
	self.hbPhase = (self.hbPhase or 0) + dt * self.hbBpm / 60
	UI:HeartShow(true)
	if self.hbPhase >= 1 then
		self.hbPhase = self.hbPhase - 1
		Audio:Play("heartbeat", { volume = 0.3 + near * 0.7, cooldown = 0.15, caption = false })
		VFX:Pulse(0.3 + near * 0.7)
		UI:HeartBeat(near)
	end
	UI:HeartUpdate(dt, self.hbPhase, self.hbBpm, near)
end

function Fear:Update(dt)
	local md, st = Monster:DistToPlayer(), Monster.state
	local base = 0
	if st ~= "Dormant" and md < math.huge then
		base = clamp(1 - md / 55, 0, 1) ^ 1.4
		if st == "Hunting" then base = base * 0.6 + 0.4 end
		if st == "Attacking" then base = 1 end
		if st == "Stalking" and md < 30 then base = base + 0.1 end
	end
	if S.battery < 15 and S.flashOn then base = base + 0.08 end
	if S.hidden and st ~= "Searching" and st ~= "Hunting" then base = base * 0.5 end
	local target = clamp(base + self.bump, 0, 1)
	self.bump = math.max(0, self.bump - dt * 0.25)
	if target > S.fear then S.fear = S.fear + (target - S.fear) * clamp(dt * 2.2, 0, 1)
	else S.fear = S.fear - (S.fear - target) * clamp(dt * 0.35, 0, 1) end
	local f = S.fear
	if st ~= "Dormant" and md < 22 and Monster.fade > 0.5 and rng:NextNumber() < 0.08 then UI:Glitch(0.12) end
	VFX.pulse = math.max(0, (VFX.pulse or 0) - dt * 3)
	UI:SetVignette(f * 0.9 + (VFX.pulse or 0) * 0.15)
	UI:SetRed(S.power and 0.05 + f * 0.08 or f * 0.12)
	UI:SetThreat(f)
	local cc, blur = Env.cc, Env.blur
	if cc then
		cc.Saturation = -0.18 - f * 0.4
		cc.TintColor = Color3.fromRGB(205, 215, 225):Lerp(Color3.fromRGB(255, 185, 185), f)
	end
	if blur then blur.Size = Opts.Reduce and 0 or math.max(0, (f - 0.7) * 12) end
	if Env.dof then Env.dof.FarIntensity = Opts.Reduce and 0 or clamp(f * 0.35, 0, 0.35) end
	if f > 0.12 and not S.hidden then
		self.hbT = self.hbT - dt
		if self.hbT <= 0 then
			self.hbT = 60 / (58 + f * 95)
			Audio:Play("heartbeat", { volume = 0.25 + f * 0.6, cooldown = 0.2, caption = false })
			VFX:Pulse(f)
		end
	end
	self:HideBeat(dt)
	self.breathT = self.breathT - dt
	if (S.stamina < 35 or f > 0.65) and self.breathT <= 0 and not S.holdBreath then
		self.breathT = f > 0.8 and 1.1 or 1.7
		Audio:Play("breath", { volume = 0.35 + f * 0.3 })
		VFX:Pulse(0.4)
	end
end

