					for _, rp in ipairs(rigParts) do rp.p.Transparency = math.min(rp.target, a) end
					RunService.RenderStepped:Wait()
				end
				for _, rp in ipairs(rigParts) do rp.p.Transparency = rp.target end
			end

			do
				local t0 = os.clock()
				while os.clock() - t0 < 2 and alive() do
					local a = os.clock() - t0
					rig:PivotTo(rigBase * CFrame.new(0, math.sin(a * 2) * 0.05, 0))
					RunService.RenderStepped:Wait()
