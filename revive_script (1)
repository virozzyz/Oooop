				local dir = V(math.cos(ang) * 0.8, 0.7, math.sin(ang) * 0.8).Unit
				local basep = o + V(tp[1], 5 + b * 0.8, tp[2])
				part("Branch", V(0.35, 0.35, 4), CFrame.lookAt(basep + dir * 2, basep + dir * 4), RGB(40, 32, 28), WD)
			end
		end

		for i = 0, 11 do
			part("Hedge", V(2.4, rand(1.6, 2.4), 3.4), at(8, 1, 10 + i * 3.8), (i % 2 == 0) and RGB(58, 56, 34) or RGB(52, 48, 30), FB)
		end

		local neon = part("NeonSign", V(0.4, 2, 14), at(2, 21, 0), RGB(255, 40, 40), Enum.Material.Neon)
		local ng = Instance.new("SurfaceGui")
		ng.Face = Enum.NormalId.Right
		ng.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		ng.PixelsPerStud = 40
		ng.Parent = neon
		local nl = Instance.new("TextLabel")
		nl.Size = UDim2.fromScale(1, 1)
		nl.BackgroundTransparency = 1
		nl.Text = "EMERGENCY"
		nl.TextScaled = true
		nl.Font = Enum.Font.GothamBold
		nl.TextColor3 = RGB(60, 0, 0)
		nl.Parent = ng
		local neonLight = Instance.new("PointLight")
		neonLight.Color = RGB(255, 40, 40)
		neonLight.Range = 40
		neonLight.Brightness = 2
		neonLight.Parent = neon
		task.spawn(function()
			while m.Parent do
				local b = 1.2 + math.sin(os.clock() * 4) * 0.9
				neonLight.Brightness = b
				neon.Transparency = (b < 0.6) and 0.5 or 0
				RunService.Heartbeat:Wait()
			end
		end)

		m.Parent = self.Folder
		return m, o + V(0, 8, 0), o
	end
end)

pcall(function()
	function Game:EscapeCutscene()
		local root, hum, cam = Char.Root, Char.Hum, Cam()
		if not root or not hum or not hum.Parent then return nil end
		local id = S.runId
		pcall(function() Anticheat:Reset(2) Anticheat.grace = 5 end)
		pcall(function() if World.exit and World.exit.part then World.exit.part.CanCollide = false end end)
		root.AssemblyLinearVelocity = Vector3.zero
		root.CFrame = CFrame.lookAt(P(LEN - 46, 3.5, 0), P(LEN, 3.5, 0))
		root.Anchored = false
		S.escapeRun = true
		pcall(function() hum.JumpPower = 0 hum.JumpHeight = 0 end)
		cam.CameraType = Enum.CameraType.Scriptable
		Audio:Duck(0.7)
		Audio.policeSiren = 0.25
		Audio:SetLoop("police_siren", 0.25)
		Audio:SetLoop("footstep_near", 0.6)
		VFX:SpeedLines(4)
		local waypoints = {
			P(LEN - 6, 3.5, 0),
			P(LEN + 20, 3.5, 0),
			P(LEN + 45, 3.5, -8),
			P(LEN + 70, 3.5, -12),
		}
		local camDir = V(1, 0, 0)
		local breathT = 0
		for _, wp in ipairs(waypoints) do
			local t0 = os.clock()
			local limit = V(wp.X - root.Position.X, 0, wp.Z - root.Position.Z).Magnitude / 16 + 4
			while os.clock() - t0 < limit and S.runId == id and S.alive do
				local rp = root.Position
				local flat = V(wp.X - rp.X, 0, wp.Z - rp.Z)
				if flat.Magnitude < 3 then break end
				hum:MoveTo(wp)
				camDir = camDir:Lerp(flat.Unit, 0.1)
				if camDir.Magnitude < 0.01 then camDir = flat.Unit end
				local behind = rp - camDir.Unit * 8 + V(0, 3, 0)
				cam.CFrame = CFrame.lookAt(behind + V(rand(-0.05, 0.05), rand(-0.05, 0.05), 0), rp + V(0, 2, 0))
				cam.FieldOfView = 70 + math.sin(os.clock() * 12) * 1.5
				VFX:Shake(0.02)
				Fear:Bump(0.2)
				breathT = breathT - 1 / 60
				if breathT <= 0 then
					breathT = 1.2
					Audio:Play("breath", { volume = 0.5, caption = false })
				end
				RunService.RenderStepped:Wait()
			end
		end
		S.escapeRun = false
		hum:MoveTo(root.Position)
		root.Anchored = true
		Audio:SetLoop("footstep_near", 0)
		Audio.policeSiren = 0.6
		Audio:SetLoop("police_siren", 0.6)
		Audio:Play("door_slam", { volume = 0.4, caption = false })
		return waypoints[#waypoints]
	end

	function Game:StartKillEnding()
		if S.elenaDead or S.ending then return end
		S.elenaDead, S.ending, S.cinematic = true, "kill", true
		local id = S.runId
		local root, cam = Char.Root, Cam()
		if root then root.Anchored = true end
		S.camLock = true
		self:UnbindInputs()
		Monster:SetState("Special")
		Monster.cinematicHold = true
		pcall(function()
			if Monster.aura then Monster.aura.Enabled = false end
			if Monster.light then Monster.light.Brightness = 0 end
		end)
		Audio:Duck(0.25)
		UI:HideChoice()
		task.spawn(function()
			local function alive() return isRun(id) end
			UI:FadeColor(Color3.fromRGB(250, 244, 218))
			for i = 1, 24 do
				if not alive() then return end
				local a = i / 24
				Lighting.ClockTime = 5.3 + a * 1.2
				Lighting.Brightness = a * 2.2
				Lighting.ExposureCompensation = -0.25 + a * 0.9
				Lighting.FogEnd = 150 + a * 280
				task.wait(0.08)
			end
			if Monster.model then
				for _, e in ipairs(Monster.partList) do
					local n = e.p.Name
					if n == "Cap" or n == "Nose" or n == "Mouth" or n:find("Stitch") or n:find("Tick") then e.p.Transparency = 1 else e.p.Color = Color3.fromRGB(118, 48, 86) end
				end
				local dress = N("Part", { Name = "ElenaDress", Size = V(2.8, 2.7, 1.5), Color = Color3.fromRGB(82, 26, 62), Material = Enum.Material.Fabric, CanCollide = false, Anchored = false, Massless = true }, Monster.model)
				dress.CFrame = Monster.root.CFrame * CFrame.new(0, -0.2, 0.2)
				N("WeldConstraint", { Part0 = Monster.root, Part1 = dress }, dress)
				table.insert(Monster.partList, { p = dress, base = 0 })
			end
			if not alive() then return end

			local bpos, byaw = Monster.pos, Monster.yaw
			local orbitStop = false
			cam.CameraType = Enum.CameraType.Scriptable
			Audio:Play("scream", { volume = 0.6, priority = true, caption = false })
			UI:KillLine("You set me free..", 4, Color3.fromRGB(235, 225, 210))
			task.spawn(function()
				local orbitDur = 7.4
				local t0 = os.clock()
				while not orbitStop and os.clock() - t0 < orbitDur and alive() do
					local a = (os.clock() - t0) / orbitDur
					local ang = a * math.pi * 1.4
					local r = 14 - a * 5
					local eye = bpos + V(math.cos(ang) * r, 3.5 + a * 3.5, math.sin(ang) * r)
					cam.CFrame = CFrame.lookAt(eye, bpos + V(0, 3.5, 0))
					cam.FieldOfView = 55 - a * 8
					RunService.RenderStepped:Wait()
				end
			end)

			VFX:BloodSplatter(bpos)
			if Monster.model and Monster.root then
				local fallStart = Monster.root.CFrame
				local fallGoal = fallStart * CFrame.Angles(math.rad(-85), 0, 0) * CFrame.new(0, 0, 1.5) + V(0, -2.3, 0)
				local t0 = os.clock()
				while os.clock() - t0 < 1.2 and alive() do
					local a = (os.clock() - t0) / 1.2
					local ease = 1 - (1 - a) ^ 3
					Monster.root.CFrame = fallStart:Lerp(fallGoal, ease)
					RunService.RenderStepped:Wait()
				end
				Audio:Play("object_fall", { volume = 0.9, priority = true })
				VFX:Shake(0.08)
				VFX:FlashBurst(bpos + V(0, 3, 0), Color3.fromRGB(255, 220, 180))
			end

			local baseList = {}
			for _, e in ipairs(Monster.partList) do
				baseList[#baseList + 1] = { p = e.p, base = e.p.Transparency }
			end
			do
				local t0 = os.clock()
				while os.clock() - t0 < 1.5 and alive() do
					local a = (os.clock() - t0) / 1.5
					local ease = a * a
					for _, b in ipairs(baseList) do
						b.p.Transparency = math.min(1, b.base + ease * (1 - b.base))
					end
					RunService.RenderStepped:Wait()
				end
				for _, b in ipairs(baseList) do b.p.Transparency = 1 end
			end
			pcall(function()
				local far = P(LEN + 4, -60, 0)
				Monster.root.CFrame = CFrame.new(far)
				Monster.pos = far
			end)
			if not alive() then return end

			local rig = World:BuildElenaRig(bpos, byaw)
			local rigBase = rig:GetPivot()
			local rigParts = {}
			for _, d in ipairs(rig:GetDescendants()) do
				if d:IsA("BasePart") then
					rigParts[#rigParts + 1] = { p = d, target = d.Transparency }
					d.Transparency = 1
				end
			end
			do
				local t0 = os.clock()
				while os.clock() - t0 < 1.2 and alive() do
