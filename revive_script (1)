			local dress = N("Part", { Name = "ElenaDress", Size = V(2.8, 2.7, 1.5), Color = Color3.fromRGB(82, 26, 62), Material = Enum.Material.Fabric, CanCollide = false, Anchored = false, Massless = true }, Monster.model)
			dress.CFrame = Monster.root.CFrame * CFrame.new(0, -0.2, 0.2)
			N("WeldConstraint", { Part0 = Monster.root, Part1 = dress }, dress)
		end
		UI:KillLine("You set me free..", 4, Color3.fromRGB(235, 225, 210))
		task.wait(4.2)
		for i = 1, 24 do
			local a = i / 24
			for _, e in ipairs(Monster.partList) do e.p.Transparency = math.min(1, e.p.Transparency + a * 0.035) end
			task.wait(0.08)
		end
		if Monster.model then Monster.model:PivotTo(CFrame.new(P(LEN + 4, -50, 0))) end
		local facade, target = World:BuildKillFacade()
		Audio.policeSiren = 0.42
		Audio:SetLoop("police_siren", 0.42)
		local start = P(LEN + 28, 8, -18)
		local look = P(LEN + 24, 8, 0)
		cam.CameraType = Enum.CameraType.Scriptable
		for i = 1, 90 do
			local a = i / 90
			cam.CFrame = CFrame.lookAt(start:Lerp(P(LEN + 44, 8, -4), a), look)
			RunService.RenderStepped:Wait()
		end
		task.wait(2)
		for i = 1, 70 do
			local a = i / 70
			cam.CFrame = CFrame.lookAt(P(LEN + 44, 8, -4), look + V(0, a * 12, 0))
			RunService.RenderStepped:Wait()
		end
		Audio.policeSiren = 0
		Audio:SetLoop("police_siren", 0)
		if facade then facade:Destroy() end
		UI:KillCredits()
		task.wait(5)
		if isRun(id) then
			UGC:Record("C")
			UI:ShowEnd("KILL HER", "Elena is free. The hospital is finally quiet.\n\nENDING C — KILL HER", Color3.fromRGB(220, 210, 190))
			UI.el.endText.Text = UI.el.endText.Text .. "\n\n" .. UGC:Summary()
		end
	end)
