function UI:Anim(dt)
	local e = self.el
	if not e.hud then return end
	if e.titleScreen.Visible then
		e.title.TextTransparency = (rng:NextNumber() < 0.04) and rand(0.3, 0.8) or 0
	end
	if self.glitchT and self.glitchT > 0 then
		self.glitchT = self.glitchT - dt
		for _, g in ipairs(e.glitch) do
			if rng:NextNumber() < 0.5 then
				g.Visible = true
				g.Position = UDim2.new(0, 0, rng:NextNumber(), 0)
				g.Size = UDim2.new(rand(0.2, 1), 0, 0, randi(2, 9))
				g.BackgroundTransparency = rand(0.6, 0.92)
			else
				g.Visible = false
			end
		end
		if self.glitchT <= 0 then for _, g in ipairs(e.glitch) do g.Visible = false end end
	end
	if S.running and e.hud.Visible then
		e.batFill.Size = UDim2.new(clamp(S.battery / 100, 0, 1), 0, 1, 0)
		e.batFill.BackgroundColor3 = S.battery < 20 and COL.red2 or COL.txt
		e.stamFill.Size = UDim2.new(clamp(S.stamina / 100, 0, 1), 0, 1, 0)
		e.noiseFill.Size = UDim2.new(clamp(S.noise, 0, 1), 0, 1, 0)
	end
end

local function ecg(p)
	if p < 0.10 then return 0.12 * math.sin(p / 0.10 * math.pi)
	elseif p >= 0.16 and p < 0.19 then return -0.15
	elseif p >= 0.19 and p < 0.23 then return 1 - math.abs(p - 0.21) / 0.02
	elseif p >= 0.23 and p < 0.27 then return -0.35 * (1 - math.abs(p - 0.25) / 0.02)
	elseif p >= 0.38 and p < 0.52 then return 0.25 * math.sin((p - 0.38) / 0.14 * math.pi) end
	return 0
end

