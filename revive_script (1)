function Inv:MakeTool(kind)
	local meta = self.META[kind]
	local tool = N("Tool", { Name = meta.name, ToolTip = meta.desc, RequiresHandle = true, CanBeDropped = false })
	Kit.realize(Kit.SPECS[kind](), tool, CFrame.new(), "tool", meta.scale or 1)
	local g0 = self.GRIPS[kind] or CFrame.new()
	tool.Grip = g0
	local data = { tool = tool, kind = kind, g0 = g0 }
	tool.Equipped:Connect(function()
		Inv.equipped = kind
		Inv.live = data
		data.equipT = os.clock()
		Inv:Refresh()
		Inv:ShowName(kind)
		Audio:Play("click", { volume = 0.3, caption = false })
	end)
	tool.Unequipped:Connect(function()
		if Inv.equipped == kind then Inv.equipped = nil end
		if Inv.live == data then Inv.live = nil end
		pcall(function() tool.Grip = g0 end)
		Inv:Refresh()
	end)
	tool.Activated:Connect(function() Inv:Use(kind) end)
	return tool
end

function Inv:Add(kind, data)
	local st = self.stacks[kind]
	if not st then
		st = { kind = kind, count = 0, list = {} }
		st.tool = self:MakeTool(kind)
		self.stacks[kind] = st
		self.order[#self.order + 1] = kind
	end
	st.count = st.count + 1
	if data then st.list[#st.list + 1] = data end
	self:Retitle(st)
	local bp = LP:FindFirstChildOfClass("Backpack")
	if st.tool.Parent == nil and bp then st.tool.Parent = bp end
	self:Refresh()
end

function Inv:Remove(kind, n)
	local st = self.stacks[kind]
	if not st or n <= 0 then return end
	st.count = st.count - n
	if st.count <= 0 then
		pcall(function() st.tool:Destroy() end)
		self.stacks[kind] = nil
		for i, k in ipairs(self.order) do
			if k == kind then table.remove(self.order, i) break end
		end
		if self.equipped == kind then self.equipped, self.live = nil, nil end
	else
		self:Retitle(st)
	end
	self:Refresh()
end

