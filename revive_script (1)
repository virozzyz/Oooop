local function setL(prop, v) pcall(function() Lighting[prop] = v end) end

function Env:Apply()
	if self.applied then return end
	self.applied = true
	self.boost = false
	self.saved, self.others = {}, {}
	for _, p in ipairs(LIGHT_PROPS) do
		local ok, v = pcall(function() return Lighting[p] end)
		if ok then self.saved[p] = v end
	end
	for _, c in ipairs(Lighting:GetChildren()) do
		if c:IsA("PostEffect") then
			self.others[#self.others + 1] = { c, "Enabled", c.Enabled }
			c.Enabled = false
		elseif c:IsA("Atmosphere") then
			self.others[#self.others + 1] = { c, "Density", c.Density }
			self.others[#self.others + 1] = { c, "Haze", c.Haze }
			c.Density = 0
			c.Haze = 0
		end
	end
	pcall(function() self.reverb = SoundService.AmbientReverb SoundService.AmbientReverb = Enum.ReverbType.Hallway end)
	self.cc = N("ColorCorrectionEffect", { Name = randName(), Contrast = 0.25, Saturation = -0.2, Brightness = -0.1,
		TintColor = Color3.fromRGB(205, 215, 225) }, Lighting)
	self.bloom = N("BloomEffect", { Name = randName(), Intensity = 0.3, Size = 22, Threshold = 0.95 }, Lighting)
	self.blur = N("BlurEffect", { Name = randName(), Size = 0 }, Lighting)
	self.dof = N("DepthOfFieldEffect", { Name = randName(), FarIntensity = 0, NearIntensity = 0, FocusDistance = 25, InFocusRadius = 25 }, Lighting)
	self.atmos = N("Atmosphere", { Name = randName(), Density = 0.2, Offset = 0, Color = Color3.new(0, 0, 0),
		Decay = Color3.new(0, 0, 0), Glare = 0, Haze = 0 }, Lighting)
	self:SetMood(false)
end

function Env:SetMood(power)
	local amb = power and Color3.fromRGB(5, 1, 1) or Color3.fromRGB(1, 1, 2)
	if self.boost then amb = power and Color3.fromRGB(32, 8, 8) or Color3.fromRGB(22, 22, 30) end
	setL("Ambient", amb)
	setL("OutdoorAmbient", amb)
	setL("Brightness", 0)
	setL("ClockTime", 0)
	setL("FogColor", power and Color3.fromRGB(12, 0, 0) or Color3.new(0, 0, 0))
	setL("FogStart", 0)
	setL("FogEnd", 150)
	setL("ExposureCompensation", -0.25)
	setL("EnvironmentDiffuseScale", 0)
	setL("EnvironmentSpecularScale", 0)
	setL("GlobalShadows", true)
	self.exp = { amb = amb, fog = 150 }
	if self.atmos then
		self.atmos.Color = Color3.new(0, 0, 0)
		self.atmos.Haze = 0
	end
end

function Env:Boost(v)
	if self.boost == v then return end
	self.boost = v
	if self.applied then self:SetMood(S.power) end
end

function Env:Restore()
	self.boost = false
	if not self.applied then return end
	self.applied = false
	for p, v in pairs(self.saved or {}) do setL(p, v) end
	for _, o in ipairs(self.others or {}) do pcall(function() o[1][o[2]] = o[3] end) end
	if self.reverb then pcall(function() SoundService.AmbientReverb = self.reverb end) end
	for _, k in ipairs({ "cc", "bloom", "blur", "atmos", "dof" }) do
		if self[k] then pcall(function() self[k]:Destroy() end) self[k] = nil end
	end
end

