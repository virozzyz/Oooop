	Kit.realize = function(specs, parent, cf, mode, scale)
		scale = scale or 1
		local holder = parent
		if mode ~= "tool" then holder = N("Model", { Name = "Item" }, parent) end
		local handle, firstOff
		for i, s in ipairs(specs) do
			local off = CFrame.new(s.off.Position * scale) * s.off.Rotation
			local p = N("Part", { Name = (i == 1) and "Handle" or "Part", Size = s.size * scale, Color = s.color, Material = s.mat,
				Transparency = s.tr, CanCollide = false, CanQuery = false, CanTouch = false, Massless = true, Anchored = mode ~= "tool",
				TopSurface = Enum.SurfaceType.Smooth, BottomSurface = Enum.SurfaceType.Smooth })
			if s.shape then p.Shape = s.shape end
			if mode ~= "tool" then p.CFrame = cf * off else p.CFrame = off end
			p.Parent = holder
			if i == 1 then
				handle, firstOff = p, off
			elseif mode == "tool" then
				N("Weld", { Part0 = handle, Part1 = p, C0 = firstOff:Inverse() * off }, p)
			end
			if s.text then
				local g = N("SurfaceGui", { Face = Enum.NormalId.Top, SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud, PixelsPerStud = 60 }, p)
				N("TextLabel", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = s.text, TextScaled = true,
