			task.spawn(function()
				local s0 = os.clock()
				local last = s0
				while os.clock() - s0 < 2 do
					local now = os.clock()
					local dt = now - last
					last = now
					local a = (now - s0) / 2
					for _, sp in ipairs(sparks) do
						sp.p.Position = sp.p.Position + sp.dir * 8 * dt
						sp.p.Transparency = a
					end
					RunService.Heartbeat:Wait()
				end
				for _, sp in ipairs(sparks) do pcall(function() sp.p:Destroy() end) end
			end)
			do
				local t0 = os.clock()
				while os.clock() - t0 < 1.2 and alive() do
					local a = (os.clock() - t0) / 1.2
					for _, rp in ipairs(rigParts) do
