local function slabRects(x1, x2, z1, z2, holes)
	local zs = { z1, z2 }
	for _, h in ipairs(holes) do zs[#zs + 1] = h.z1 zs[#zs + 1] = h.z2 end
	table.sort(zs)
	local out = {}
	for i = 1, #zs - 1 do
		local za, zb = zs[i], zs[i + 1]
		if zb - za > 0.01 then
			local mid = (za + zb) / 2
			local segs = { { x1, x2 } }
			for _, h in ipairs(holes) do
				if mid > h.z1 and mid < h.z2 then
					local nx = {}
					for _, s in ipairs(segs) do
						if h.x2 <= s[1] or h.x1 >= s[2] then
							nx[#nx + 1] = s
						else
							if h.x1 > s[1] then nx[#nx + 1] = { s[1], h.x1 } end
							if h.x2 < s[2] then nx[#nx + 1] = { h.x2, s[2] } end
						end
					end
					segs = nx
				end
			end
			for _, s in ipairs(segs) do out[#out + 1] = { s[1], s[2], za, zb } end
		end
	end
	return out
end

local SolidParts = setmetatable({}, { __mode = "k" })
local SOLID_BY_NAME = { W = true, Lintel = true, Slab = true, Roof = true, Ceiling = true, Locker = true, Ramp = true }
local function mk(parent, name, size, cf, color, mat, transp, collide)
	local p = Instance.new("Part")
	p.Name = randName()
	if SOLID_BY_NAME[name] then SolidParts[p] = true end
	p.CanTouch = false
	p.Anchored = true
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = mat or Enum.Material.Concrete
	p.Transparency = transp or 0
	p.CanCollide = collide ~= false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent
	return p
end
local function dk(parent, name, size, cf, color, mat, collide)
	local p = mk(parent, name, size, cf, color, mat, 0, collide)
	p.CanQuery = false
	return p
end

local function sign(parent, text, pos, dir, size)
	local p = dk(parent, "Sign", size or V(6, 1.3, 0.15), CFrame.lookAt(pos, pos + dir), Color3.fromRGB(22, 22, 22), Enum.Material.Metal, false)
	local g = N("SurfaceGui", { Face = Enum.NormalId.Front, SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud, PixelsPerStud = 50 }, p)
	local l = N("TextLabel", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = text, TextScaled = true,
		Font = Enum.Font.SpecialElite, TextColor3 = Color3.fromRGB(165, 40, 36) }, g)
	return p, l
end

