	for _ = 1, randi(2, 4) do
		local sx, sy, sz = rand(1.2, 2.6), rand(0.8, 2.2), rand(1.2, 2.6)
		dk(self.Decor, "Crate", V(sx, sy, sz),
			C(room.cx + rand(-11, 11), sy / 2, room.side * (ROOMC + rand(-8, 12))) * CFrame.Angles(0, rand(0, 6.28), 0),
			pick(cols), Enum.Material.Wood, true)
	end
end

function World:BuildRooms(def)
	local steel, wood, white = Color3.fromRGB(88, 94, 98), Color3.fromRGB(70, 54, 42), Color3.fromRGB(150, 150, 146)
	for _, spec in ipairs(def.specs) do
		local room = { id = spec.id, name = spec.name, cx = spec.cx, side = spec.side, floor = def.fi, fy = def.fi * FH,
			center = P(spec.cx, 0, spec.side * ROOMC), stains = {}, lamps = {} }
		self.RoomList[#self.RoomList + 1] = room
		self.RoomById[spec.id] = room
		def.rooms[#def.rooms + 1] = room
		self:MakeDoor(room)
		sign(self.Decor, spec.name, P(spec.cx, 9.5, spec.side * 4.35), V(0, 0, -spec.side))
		local _, lbl = sign(self.Decor, spec.name, P(spec.cx, 7.6, spec.side * (BACK - 0.7)), V(0, 0, -spec.side), V(8, 1.4, 0.15))
		room.signLabel, room.signText = lbl, spec.name
		stain(room, rand(-8, 8), rand(2, 8), rand(2, 4), false)
		stain(room, rand(-8, 8), rand(2, 8), rand(3, 5), true)
		local id = spec.id
		if spec.style then
			styleRoom(room, spec.style)
			self:SideTables(room)
		elseif id == "N1" then
			furn(room, 0, 2, 12, 3, 2.5, wood)
			furn(room, 0, 10, 20, 6, 1.2, steel)
			furn(room, -10, 4, 2, 2.5, 2, wood)
		elseif id == "S1" then
			furn(room, -8, 0, 2, 1.4, 12, wood)
			furn(room, 8, 0, 2, 1.4, 12, wood)
			furn(room, 0, 9, 6, 2, 2, wood)
		elseif id == "N2" then
			furn(room, 0, 3, 14, 3.2, 2.5, white, Enum.Material.Metal)
			furn(room, 0, 10, 22, 7, 1.5, steel, Enum.Material.Metal)
		elseif id == "S2" then
			furn(room, 0, 4, 5, 6, 5, steel, Enum.Material.Metal)
			furn(room, -8, -1, 4, 2.6, 8, white, Enum.Material.Metal)
		elseif id == "N3" then
			furn(room, 0, 5, 5, 2.2, 9, white)
			furn(room, 5, 2, 2, 2.4, 2, wood)
			furn(room, -9, 9, 1, 8, 8, Color3.fromRGB(60, 70, 60), Enum.Material.Fabric)
		elseif id == "S3" then
			furn(room, 0, 6, 9, 3, 3.5, wood)
			furn(room, -9, 9, 1.5, 7, 6, steel, Enum.Material.Metal)
		elseif id == "N4" then
			local g = furn(room, -6, 3, 9, 5, 5, Color3.fromRGB(52, 56, 60), Enum.Material.Metal)
			local panel = dk(self.Decor, "Panel", V(3, 1.5, 0.2), CFrame.new(g.Position.X, g.Position.Y + 0.5, g.Position.Z - room.side * 2.55), Color3.fromRGB(120, 20, 20), Enum.Material.Neon, false)
			panel.Transparency = 0.6
		elseif id == "S4" then
			furn(room, 0, 10, 24, 5, 2.5, steel, Enum.Material.Metal)
			furn(room, 0, 2, 8, 2.6, 3, white, Enum.Material.Metal)
			furn(room, -9, -1, 3, 2.4, 8, white, Enum.Material.Metal)
		elseif id == "N5" then
			furn(room, 0, 3, 6, 3, 10, white, Enum.Material.Metal)
			furn(room, -9, 2, 3, 3, 3, steel, Enum.Material.Metal)
			furn(room, 8, 12, 2, 5, 10, steel, Enum.Material.Metal)
			iv(room, 5, 0)
		elseif id == "S5" then
			furn(room, -9, 2, 1.5, 7, 22, wood)
			furn(room, 0, 8, 1.5, 7, 18, wood)
			furn(room, 9, -4, 5, 3, 3, wood)
		elseif id == "N6" then
			for r = 0, 2 do
				furn(room, -6, -6 + r * 5, 7, 2, 1.6, wood)
				furn(room, 6, -6 + r * 5, 7, 2, 1.6, wood)
			end
			furn(room, 0, 14, 8, 3.2, 2.5, white, Enum.Material.Marble)
			for _, cx in ipairs({ -3, 3 }) do
				local c = dk(self.Decor, "Candle", V(0.4, 1.2, 0.4), C(room.cx + cx, 3.2 + 0.6, room.side * (ROOMC + 14)), Color3.fromRGB(230, 220, 190), Enum.Material.SmoothPlastic, false)
				N("PointLight", { Range = 6, Brightness = 0.5, Color = Color3.fromRGB(255, 190, 110) }, c)
			end
		elseif id == "S6" then
			furn(room, 0, 4, 16, 3, 2.5, steel, Enum.Material.Metal)
			furn(room, -9, 12, 2, 3, 12, steel, Enum.Material.Metal)
			furn(room, 9, 10, 2, 2.4, 2, white, Enum.Material.Metal)
		elseif id == "N7" then
			bed(room, -6, 3) bed(room, 6, 3) bed(room, -6, 12) bed(room, 6, 12)
			iv(room, -3.5, 3) iv(room, 3.5, 12)
		elseif id == "S7" then
			furn(room, -6, 3, 10, 3, 2.5, white, Enum.Material.Metal)
			furn(room, 6, 9, 10, 3, 2.5, white, Enum.Material.Metal)
			furn(room, 0, 16, 14, 6, 1.2, steel, Enum.Material.Metal)
		elseif id == "N8" then
			furn(room, -6, 6, 8, 9, 8, steel, Enum.Material.Metal)
			furn(room, 5, 12, 1, 10, 10, steel, Enum.Material.Metal)
			furn(room, 7, 2, 2.5, 2.4, 2.5, wood)
		elseif id == "S8" then
			furn(room, 0, 8, 10, 3.2, 3.5, wood)
			furn(room, -9, 14, 1.2, 8, 10, wood)
			furn(room, 9, 14, 1.2, 8, 10, wood)
		end
		self:Clutter(room)
		pcall(function() self:RoomDetail(room, spec) end)
	end
	local skip = { S4 = true, F2N3 = true, B1N2 = true }
	local cands = {}
	for _, r in ipairs(def.rooms) do if not skip[r.id] then cands[#cands + 1] = r.id end end
	for _ = 1, (def.fi == 0 and 5 or 3) do
		if #cands == 0 then break end
		local k = table.remove(cands, randi(1, #cands))
		Doors:Set(self.Doors[k], true, "init", true)
	end
	if def.fi == 0 then
		local gr = self.RoomById["N4"]
		local fb = dk(self.Decor, "FuseBox", V(2.6, 3.4, 0.5), C(gr.cx + 4, 4.4, gr.side * (BACK - 0.8)), Color3.fromRGB(60, 66, 62), Enum.Material.Metal, false)
		dk(self.Decor, "FuseLed", V(0.4, 0.4, 0.1), C(gr.cx + 4, 5.6, gr.side * (BACK - 1.1)), Color3.fromRGB(230, 40, 30), Enum.Material.Neon, false)
		self.fuseBox = fb
		self.fuseFilled = 0
		pcall(function() self:FuseBoxDetail(gr, fb) end)
		self.fuseSparks = N("ParticleEmitter", { Rate = 0, Lifetime = NumberRange.new(0.3, 0.7), Speed = NumberRange.new(8, 16), SpreadAngle = Vector2.new(70, 70),
			Acceleration = V(0, -30, 0), LightEmission = 1, Color = ColorSequence.new(Color3.fromRGB(255, 220, 120)),
			Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.25), NumberSequenceKeypoint.new(1, 0) }) }, fb)
		self:Prompt(fb, "Fuse box", "Insert fuses", function() Story:InsertFuses() end, { dist = 8, hold = 2 })
	end
end

function World:ApplyLocks()
	local d = self.Doors
	d["S4"].locked, d["S4"].lockMsg = true, "Electronically locked. No power."
	d["F2N3"].locked, d["F2N3"].lockMsg = true, "Locked. Someone hid the key in a quiet place."
	d["B1N2"].locked, d["B1N2"].lockMsg = true, "Electronically locked. No power."
end

function World:MakeLocker(cf)
	local los = self.LOSF
	local col = Color3.fromRGB(58, 66, 70)
	local function panel(size, off) return mk(los, "Locker", size, cf * off, col, Enum.Material.Metal) end
	panel(V(LW, LH, 0.2), CFrame.new(0, 0, LD / 2 - 0.1))
	panel(V(0.2, LH, LD), CFrame.new(-LW / 2 + 0.1, 0, 0))
	panel(V(0.2, LH, LD), CFrame.new(LW / 2 - 0.1, 0, 0))
	panel(V(LW, 0.2, LD), CFrame.new(0, LH / 2 - 0.1, 0))
	panel(V(LW, 0.2, LD), CFrame.new(0, -LH / 2 + 0.1, 0))
	local front = mk(los, "LockerFront", V(LW, LH - 0.4, 0.2), cf * CFrame.new(0, 0, -LD / 2 + 0.1), Color3.fromRGB(70, 80, 84), Enum.Material.Metal)
	for i = -1, 1 do
		dk(self.Decor, "Vent", V(LW - 0.8, 0.12, 0.05), cf * CFrame.new(0, 2.2 + i * 0.35, -LD / 2 - 0.05), Color3.fromRGB(20, 22, 24), Enum.Material.Metal, false)
	end
	local lk = { cf = cf, front = front, pos = cf.Position }
	lk.prompt = self:Prompt(front, "Locker", "Hide", function()
		if S.hidden and S.hideSpot == lk then Player:Unhide() else Player:Hide(lk) end
	end, { dist = 7, hidden = true })
	self.Lockers[#self.Lockers + 1] = lk
	return lk
end

