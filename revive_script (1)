function World:Clock(pos, inward)
	local D, RGB = self.Decor, Kit.RGB
	local cf = CFrame.lookAt(pos, pos + inward) * CFrame.Angles(0, math.pi / 2, 0)
	local rim = dk(D, "ClockRim", V(0.3, 2.7, 2.7), cf, RGB(26, 26, 28), Enum.Material.Metal, false)
	rim.Shape = Enum.PartType.Cylinder
	local face = dk(D, "ClockFace", V(0.34, 2.3, 2.3), cf * CFrame.new(0.03, 0, 0), RGB(205, 200, 186), Enum.Material.SmoothPlastic, false)
	face.Shape = Enum.PartType.Cylinder
	local up = V(0, 1, 0)
	local right = (-inward):Cross(up).Unit
	local function hand(a, len, th, col)
		local dir = right * math.sin(a) + up * math.cos(a)
		local c = pos + inward * 0.26 + dir * (len / 2)
		dk(D, "Hand", V(th, th, len), CFrame.lookAt(c, c + dir), col, Enum.Material.SmoothPlastic, false)
	end
	hand(math.rad(96), 0.7, 0.1, RGB(15, 15, 15))
	hand(math.rad(72), 1.0, 0.07, RGB(15, 15, 15))
	hand(math.rad(200), 1.05, 0.03, RGB(150, 20, 20))
	for _, a in ipairs({ 0, 90, 180, 270 }) do
		local dir = right * math.sin(math.rad(a)) + up * math.cos(math.rad(a))
		local c = pos + inward * 0.22 + dir * 1.0
		dk(D, "Tick", V(0.08, 0.08, 0.2), CFrame.lookAt(c, c + dir), RGB(20, 20, 20), Enum.Material.SmoothPlastic, false)
	end
end

